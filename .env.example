PORT=3000
NODE_ENV=development

# ——— Option A: Supabase (PostgreSQL) ———
# DATABASE_URL=postgresql://postgres.[ref]:[PASSWORD]@[host]:6543/postgres
# DB_SSL=true

# ——— Option B: MySQL (local / cPanel) ———
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=rakushopbd

SESSION_SECRET=change-this-to-a-long-random-string

ADMIN_USERNAME=admin@rakushopbd.com
ADMIN_EMAIL=admin@rakushopbd.com
ADMIN_PASSWORD=your-secure-password-here

# After changing ADMIN_* run: npm run admin:sync

# ——— Email notifications (optional — can also set in Admin → Settings → Delivery) ———
# Recipient (can also set in Admin → Settings → Delivery & Features)
NOTIFY_EMAIL=diderjp@gmail.com
# Gmail: use an App Password — https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=diderjp@gmail.com
SMTP_PASS=your-gmail-app-password
# SMTP_FROM=diderjp@gmail.com

# Perfect Corp YouCam — AI Face Analyzer (https://yce.perfectcorp.com/)
# API console: https://yce.makeupar.com/api-console/en/api-keys/
# V2 endpoints use API key as Bearer (sk-...). Secret is RSA public key (V1 auth only).
# YOUCAM_API_KEY=sk-your-api-key-here
# YOUCAM_CLIENT_SECRET=MIGfMA0GCSqGSIb3...   # optional, save when generated
# YOUCAM_API_BASE=https://yce-api-01.makeupar.com

# Public URL for SEO (canonical, sitemap, Open Graph)
# SITE_URL=https://www.rakushopbd.com
