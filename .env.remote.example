# Mac থেকে live cPanel MySQL (Remote Database Access + আপনার IP whitelist)
# Copy: cp .env.remote.example .env.remote
# তারপর DB_PASSWORD = cPanel MySQL password

PORT=3000
NODE_ENV=development

DB_HOST=rakushopbd.com
DB_PORT=3306
DB_USER=rakushop_rakushopbd
DB_PASSWORD=your_cpanel_mysql_password_here
DB_NAME=rakushop_rakushopbd

SESSION_SECRET=CHANGE_ME_SESSION_SECRET
ADMIN_USERNAME=admin@rakushopbd.com
ADMIN_EMAIL=admin@rakushopbd.com
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
