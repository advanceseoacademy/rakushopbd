{
  "name": "rakushopbd",
  "version": "1.0.0",
  "description": "RakuShopBD — Bangladesh e-commerce (Node.js + MySQL or Supabase)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:remote": "node scripts/start-remote.js",
    "dev": "node --watch server.js",
    "db:test-remote": "node scripts/test-remote-db.js",
    "db:setup": "node scripts/setup-db.js",
    "db:fresh": "node scripts/fresh-db.js",
    "db:build-sql": "node scripts/build-full-sql.js",
    "db:build:supabase": "node scripts/build-supabase-sql.js",
    "db:setup:supabase": "node scripts/setup-supabase.js",
    "db:apply:supabase": "node scripts/supabase-apply-sql.js",
    "db:test:supabase": "node scripts/test-supabase-connection.js",
    "db:brand-colors": "node scripts/update-brand-colors.js",
    "admin:sync": "node scripts/sync-admin.js",
    "seo:sitemap": "node scripts/generate-sitemap.js",
    "cpanel:env": "node scripts/generate-cpanel-env.js",
    "local:setup": "npm run db:setup && npm run admin:sync",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:restart": "pm2 restart rakushopbd",
    "uploads:migrate-webp": "node scripts/migrate-uploads-to-webp.js",
    "build:js": "node scripts/minify-js.js",
    "build:js:force": "node scripts/minify-js.js --force",
    "build:css": "node scripts/minify-css.js",
    "build:css:force": "node scripts/minify-css.js --force",
    "build:home-css": "node scripts/build-home-css-bundle.js",
    "build:assets": "npm run build:home-css && npm run build:css && npm run build:js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "clean-css": "^5.3.3",
    "compression": "^1.8.1",
    "cookie-session": "^2.1.0",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "multer": "^2.1.1",
    "mysql2": "^3.12.0",
    "nodemailer": "^6.10.1",
    "pg": "^8.21.0",
    "sharp": "^0.33.5",
    "terser": "^5.39.0"
  }
}
