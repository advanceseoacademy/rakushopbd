{
  "name": "rakushopbd",
  "version": "1.0.0",
  "description": "RakuShopBD — Bangladesh e-commerce (Node.js + MySQL)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:remote": "node scripts/start-remote.js",
    "dev": "node --watch server.js",
    "db:test-remote": "node scripts/test-remote-db.js",
    "db:setup": "node scripts/setup-db.js",
    "db:fresh": "node scripts/fresh-db.js",
    "db:build-sql": "node scripts/build-full-sql.js",
    "db:brand-colors": "node scripts/update-brand-colors.js",
    "admin:sync": "node scripts/sync-admin.js",
    "cpanel:env": "node scripts/generate-cpanel-env.js",
    "local:setup": "npm run db:setup && npm run admin:sync"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-session": "^2.1.0",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "multer": "^2.1.1",
    "mysql2": "^3.12.0"
  }
}
