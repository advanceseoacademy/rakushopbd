<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="robots" content="noindex, nofollow">
<title>RakuShopBD — Admin Panel</title>
<link rel="icon" href="/images/rakushopbd-logo.png?v=10" type="image/png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">
<link rel="stylesheet" href="/css/admin.css?v=22">
<link rel="stylesheet" href="/css/popup-themes.css?v=1">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css">
<style>body{font-family:'Inter',sans-serif;}.toast{position:fixed;bottom:24px;right:24px;background:#0f172a;color:#fff;padding:12px 20px;border-radius:10px;font-size:13px;z-index:9999;opacity:0;transition:opacity .2s;}.toast.show{opacity:1;}.modal-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:200;align-items:center;justify-content:center;padding:20px;}.modal-overlay.open{display:flex;}.modal-box{background:#fff;border-radius:16px;max-width:520px;width:100%;max-height:90vh;overflow:auto;padding:24px;}.modal-box h3{margin-bottom:16px;font-size:18px;}</style>
</head>
<body>

<div id="login-page">
  <div class="login-card">
    <div class="login-logo">
      <img src="/images/rakushopbd-logo.png?v=10" alt="RakuShopBD" class="site-logo-img site-logo-img--admin-login" width="300" height="80">
    </div>
    <div class="login-tagline">Admin Dashboard — Sign in to manage your store</div>
    <div class="login-error" id="login-error"><i class="ti ti-alert-circle"></i> <span>Invalid username or password</span></div>
    <form id="login-form">
      <label class="login-label">Username / Email</label>
      <input class="login-input" id="inp-user" type="text" placeholder="admin or admin@rakushopbd.com" autocomplete="username" required>
      <label class="login-label">Password</label>
      <div style="position:relative;">
        <input class="login-input" id="inp-pass" type="password" placeholder="••••••••" autocomplete="current-password" required style="padding-right:44px;">
        <button type="button" id="toggle-pass" style="position:absolute;right:12px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;color:#94a3b8;font-size:18px;"><i class="ti ti-eye" id="pass-eye"></i></button>
      </div>
      <button class="login-btn" type="submit" style="margin-top:8px;"><i class="ti ti-lock"></i> Sign In</button>
    </form>
  </div>
</div>

<div id="admin-page">
<div class="adm-layout">
  <div class="adm-sidebar-overlay" id="adm-sidebar-overlay" aria-hidden="true"></div>
  <aside class="sidebar" id="adm-sidebar">
    <div class="sidebar-logo">
      <img src="/images/rakushopbd-logo.png?v=10" alt="RakuShopBD" class="site-logo-img site-logo-img--admin-sidebar" width="240" height="58">
      <div class="sidebar-version">Admin Panel</div>
    </div>
    <div class="sidebar-section">Main</div>
    <div class="nav-item active" data-page="dashboard"><i class="ti ti-dashboard"></i> Dashboard</div>
    <div class="nav-item" data-page="orders"><i class="ti ti-shopping-bag"></i> Orders <span class="nav-badge" id="order-badge">0</span></div>
    <div class="nav-item" data-page="appointments"><i class="ti ti-calendar"></i> Appointments <span class="nav-badge nav-badge-amber" id="appointment-badge">0</span></div>
    <div class="nav-item" data-page="contacts"><i class="ti ti-mail"></i> Contact Messages <span class="nav-badge nav-badge-amber" id="contact-badge">0</span></div>
    <div class="nav-item" data-page="products"><i class="ti ti-box"></i> Products</div>
    <div class="nav-item" data-page="gallery"><i class="ti ti-photo"></i> Image Gallery</div>
    <div class="nav-item" data-page="customers"><i class="ti ti-users"></i> Customers</div>
    <div class="nav-item" data-page="analytics"><i class="ti ti-chart-bar"></i> Analytics</div>
    <div class="sidebar-section">Manage</div>
    <div class="nav-item" data-page="categories"><i class="ti ti-category"></i> Categories</div>
    <div class="nav-group" id="nav-group-pages">
      <button type="button" class="nav-group-toggle" id="nav-pages-toggle" aria-expanded="false">
        <span class="nav-group-label"><i class="ti ti-files"></i> Pages</span>
        <i class="ti ti-chevron-down nav-group-chevron"></i>
      </button>
      <div class="nav-sub">
        <button type="button" class="nav-sub-item" data-page="faq"><i class="ti ti-help-circle"></i> FAQ</button>
        <button type="button" class="nav-sub-item" data-page="legal" data-legal-tab="privacy"><i class="ti ti-shield-lock"></i> Privacy Policy</button>
        <button type="button" class="nav-sub-item" data-page="legal" data-legal-tab="terms"><i class="ti ti-file-text"></i> Terms &amp; Conditions</button>
        <button type="button" class="nav-sub-item" data-page="legal" data-legal-tab="return"><i class="ti ti-refresh"></i> Return Policy</button>
        <button type="button" class="nav-sub-item" data-page="legal" data-legal-tab="preorder"><i class="ti ti-clock-hour-4"></i> Pre-Order Policy</button>
        <button type="button" class="nav-sub-item" data-page="legal" data-legal-tab="points"><i class="ti ti-award"></i> Reward Point Policy</button>
      </div>
    </div>
    <div class="nav-item" data-page="coupons"><i class="ti ti-discount"></i> Coupons</div>
    <div class="nav-item" data-page="reviews"><i class="ti ti-star"></i> Reviews <span class="nav-badge nav-badge-amber" id="review-badge">0</span></div>
    <div class="nav-item" data-page="banners"><i class="ti ti-photo"></i> Banners</div>
    <div class="nav-item" data-page="marketing"><i class="ti ti-speakerphone"></i> Marketing <span class="nav-badge nav-badge-amber" id="subscriber-badge">0</span></div>
    <div class="nav-item" data-page="messenger"><i class="ti ti-brand-messenger"></i> Messenger Chats</div>
    <div class="nav-item" data-page="settings"><i class="ti ti-settings"></i> Settings</div>
    <div class="sidebar-footer">
      <div class="sidebar-user">
        <div class="sidebar-avatar" id="sidebar-avatar">A</div>
        <div>
          <div class="sidebar-username" id="sidebar-name">Admin</div>
          <div class="sidebar-email" id="sidebar-email">—</div>
        </div>
      </div>
      <button type="button" class="logout-btn" id="logout-btn"><i class="ti ti-logout"></i> Sign Out</button>
    </div>
  </aside>

  <div class="adm-main">
    <div class="topbar">
      <div class="topbar-left">
        <button type="button" class="adm-menu-btn" id="adm-menu-btn" aria-label="Open menu" aria-expanded="false"><i class="ti ti-menu-2"></i></button>
        <div>
          <div class="topbar-title" id="page-title">Dashboard</div>
          <div class="breadcrumb"><i class="ti ti-home" style="font-size:11px;"></i> Home <i class="ti ti-chevron-right" style="font-size:10px;"></i> <span id="breadcrumb-current">Dashboard</span></div>
        </div>
      </div>
      <div class="topbar-right">
        <button type="button" class="topbar-btn" id="view-site-btn"><i class="ti ti-external-link"></i> <span class="topbar-btn-label">View Store</span></button>
        <div class="topbar-avatar" id="topbar-avatar">A</div>
      </div>
    </div>

    <div class="adm-content">

      <div class="adm-section active" id="sec-dashboard">
        <div class="stats-grid" id="dash-stats"></div>
        <div class="charts-row">
          <div class="card">
            <div class="card-title">Monthly Revenue (৳ thousands)</div>
            <canvas id="revenue-chart" width="600" height="220" style="max-width:100%;"></canvas>
          </div>
          <div class="card">
            <div class="card-title">Order Status</div>
            <canvas id="donut-chart" width="260" height="160" style="display:block;margin:0 auto;"></canvas>
            <div class="donut-legend" id="donut-legend"></div>
          </div>
        </div>
        <div class="side-layout">
          <div class="table-wrap" style="margin:0;">
            <div class="table-header"><h3>Recent Orders</h3><button type="button" class="btn btn-outline btn-sm" data-goto="orders">View all</button></div>
            <table class="tbl"><thead><tr><th>Order</th><th>Customer</th><th>Items</th><th>Total</th><th>Status</th></tr></thead>
            <tbody id="dash-orders-tbody"></tbody></table>
            <div class="pagination-bar" id="dash-orders-pagination" hidden></div>
          </div>
          <div class="card" style="margin:0;">
            <div class="card-title">Recent Activity</div>
            <div class="activity-list" id="dash-activity"></div>
          </div>
        </div>
      </div>

      <div class="adm-section" id="sec-orders">
        <div class="table-wrap" style="margin:0;">
          <div class="table-header">
            <h3>All Orders</h3>
            <div class="table-actions">
              <input class="tbl-search" id="orders-search" type="text" placeholder="Search orders...">
              <select class="tbl-select" id="orders-status-filter">
                <option value="all">All status</option>
                <option value="pending">Pending</option>
                <option value="confirmed">Confirmed</option>
                <option value="shipped">Shipped</option>
                <option value="delivered">Delivered</option>
                <option value="cancelled">Cancelled</option>
              </select>
              <select class="tbl-select" id="orders-payment-filter">
                <option value="all">All payment</option>
                <option value="cod">COD</option>
                <option value="bkash">bKash</option>
                <option value="nagad">Nagad</option>
                <option value="card">Card</option>
              </select>
              <button type="button" class="btn btn-danger btn-sm" id="orders-bulk-delete-btn" hidden>
                <i class="ti ti-trash"></i> Delete selected (<span id="orders-selected-count">0</span>)
              </button>
              <button type="button" class="btn btn-outline btn-sm" id="orders-clear-selection-btn" hidden>Clear</button>
              <a href="/api/admin/orders/export" class="btn btn-primary btn-sm" id="orders-export-btn" target="_blank"><i class="ti ti-download"></i> Export</a>
            </div>
          </div>
          <table class="tbl"><thead><tr>
            <th class="tbl-check-col"><input type="checkbox" id="orders-select-all" title="Select all on this page" aria-label="Select all orders on this page"></th>
            <th>Order ID</th><th>Customer</th><th>Items</th><th>Payment</th><th>Date</th><th>Total</th><th>Status</th><th>Action</th></tr></thead>
          <tbody id="orders-tbody"></tbody></table>
          <div class="pagination-bar" id="orders-pagination"></div>
        </div>
      </div>

      <div class="adm-section" id="sec-appointments">
        <div class="table-wrap" style="margin:0;">
          <div class="table-header">
            <h3>Customer Appointments</h3>
            <div class="table-actions">
              <input class="tbl-search" id="appointments-search" type="text" placeholder="Search ref, name, phone, notes...">
              <select class="tbl-select" id="appointments-status-filter">
                <option value="all">All status</option>
                <option value="pending">Pending</option>
                <option value="confirmed">Confirmed</option>
                <option value="completed">Completed</option>
                <option value="cancelled">Cancelled</option>
              </select>
              <button type="button" class="btn btn-danger btn-sm" id="appointments-bulk-delete-btn" hidden>
                <i class="ti ti-trash"></i> Delete selected (<span id="appointments-selected-count">0</span>)
              </button>
              <button type="button" class="btn btn-outline btn-sm" id="appointments-clear-selection-btn" hidden>Clear</button>
            </div>
          </div>
          <table class="tbl"><thead><tr>
            <th class="tbl-check-col"><input type="checkbox" id="appointments-select-all" title="Select all on this page" aria-label="Select all appointments on this page"></th>
            <th>Reference</th><th>Customer</th><th>Service</th><th>Date & time</th><th>Notes</th><th>Status</th><th>Action</th></tr></thead>
          <tbody id="appointments-tbody"></tbody></table>
          <div class="pagination-bar" id="appointments-pagination"></div>
        </div>
      </div>

      <div class="adm-section" id="sec-contacts">
        <div class="table-wrap" style="margin:0;">
          <div class="table-header">
            <h3>Contact form messages</h3>
            <div class="table-actions">
              <input class="tbl-search" id="contacts-search" type="text" placeholder="Search name, phone, subject, message...">
              <select class="tbl-select" id="contacts-status-filter">
                <option value="all">All status</option>
                <option value="new">New</option>
                <option value="read">Read</option>
                <option value="replied">Replied</option>
                <option value="archived">Archived</option>
              </select>
              <button type="button" class="btn btn-danger btn-sm" id="contacts-bulk-delete-btn" hidden>
                <i class="ti ti-trash"></i> Delete selected (<span id="contacts-selected-count">0</span>)
              </button>
              <button type="button" class="btn btn-outline btn-sm" id="contacts-clear-selection-btn" hidden>Clear</button>
            </div>
          </div>
          <table class="tbl"><thead><tr>
            <th class="tbl-check-col"><input type="checkbox" id="contacts-select-all" title="Select all on this page" aria-label="Select all contact messages on this page"></th>
            <th>Customer</th><th>Subject</th><th>Message</th><th>Date</th><th>Status</th><th>Action</th></tr></thead>
          <tbody id="contacts-tbody"></tbody></table>
          <div class="pagination-bar" id="contacts-pagination"></div>
        </div>
      </div>

      <div class="adm-section" id="sec-products">
        <div class="table-wrap" style="margin:0;">
          <div class="table-header">
            <h3>Products</h3>
            <div class="table-actions">
              <input class="tbl-search" id="products-search" type="text" placeholder="Search products...">
              <select class="tbl-select" id="products-cat-filter"><option value="all">All categories</option></select>
              <button type="button" class="btn btn-danger btn-sm" id="products-bulk-delete-btn" hidden>
                <i class="ti ti-trash"></i> Delete selected (<span id="products-selected-count">0</span>)
              </button>
              <button type="button" class="btn btn-outline btn-sm" id="products-clear-selection-btn" hidden>Clear</button>
              <button type="button" class="btn btn-primary btn-sm" id="add-product-btn"><i class="ti ti-plus"></i> Add Product</button>
            </div>
          </div>
          <table class="tbl"><thead><tr>
            <th class="tbl-check-col"><input type="checkbox" id="products-select-all" title="Select all on this page" aria-label="Select all products on this page"></th>
            <th>Product</th><th>Category</th><th>Sale price</th><th>Buy price</th><th>Stock</th><th>Featured</th><th>Actions</th></tr></thead>
          <tbody id="products-tbody"></tbody></table>
          <div class="pagination-bar" id="products-pagination"></div>
        </div>
      </div>

      <div class="adm-section" id="sec-gallery">
        <div class="table-wrap" style="margin:0;">
          <div class="table-header">
            <h3>Product Image Gallery</h3>
            <div class="table-actions">
              <input class="tbl-search" id="gallery-search" type="text" placeholder="Search product or image URL...">
              <select class="tbl-select" id="gallery-cat-filter"><option value="all">All categories</option></select>
            </div>
          </div>
          <div class="gallery-stats" id="gallery-stats"></div>
          <div class="gallery-grid" id="gallery-grid"></div>
          <div class="pagination-bar" id="gallery-pagination"></div>
        </div>
      </div>

      <div class="adm-section" id="sec-product-form">
        <div class="product-form-page">
          <div class="product-form-head">
            <button type="button" class="btn btn-outline btn-sm" id="product-form-back"><i class="ti ti-arrow-left"></i> Back to Products</button>
            <h2 id="product-form-title">Add Product</h2>
          </div>
          <div class="card product-form-card">
            <form id="product-form">
              <input type="hidden" id="pf-id" value="">
              <div class="form-section-title">Basic info</div>
              <div class="form-group"><label class="form-label">Product name *</label><input class="form-input" id="pf-name" required></div>
              <div class="form-group"><label class="form-label">URL slug</label><input class="form-input" id="pf-slug" placeholder="auto from name, e.g. smartwatch-pro"><small class="form-hint">Store link: /product/your-slug</small></div>
              <div class="form-section-title">Product category</div>
              <div class="product-cat-pickers">
                <div class="product-cat-step">
                  <div class="product-cat-step-head">
                    <span class="product-cat-step-num">1</span>
                    <div>
                      <label class="form-label" for="pf-main-cat">Main category *</label>
                      <small class="form-hint">Select the top-level category (e.g. Electronics, Fashion)</small>
                    </div>
                  </div>
                  <select class="form-input form-select" id="pf-main-cat" required>
                    <option value="">Select main category</option>
                  </select>
                </div>
                <div class="product-cat-step" id="pf-sub-cat-wrap" hidden>
                  <div class="product-cat-step-head">
                    <span class="product-cat-step-num">2</span>
                    <div>
                      <label class="form-label" for="pf-sub-cat">Subcategory</label>
                      <small class="form-hint" id="pf-sub-cat-hint">Optional — choose a subcategory under the main category</small>
                    </div>
                  </div>
                  <select class="form-input form-select" id="pf-sub-cat">
                    <option value="">Use main category only (no subcategory)</option>
                  </select>
                </div>
                <div class="product-cat-path" id="pf-cat-selected" hidden>
                  <span class="product-cat-path-label">Product will be listed under:</span>
                  <div class="product-cat-path-flow" id="pf-cat-path-flow"></div>
                </div>
              </div>
              <input type="hidden" id="pf-category" value="">
              <div class="form-2col">
                <div class="form-group"><label class="form-label">MRP / Regular price (৳)</label><input class="form-input" id="pf-old-price" type="number" min="0" step="0.01"><small class="form-hint">Original list price — shown as strikethrough on the storefront</small></div>
                <div class="form-group"><label class="form-label">Discount (%)</label><input class="form-input" id="pf-discount-percent" type="number" min="0" max="99" placeholder="0"><small class="form-hint">Discount percentage — set to 0 to hide the discount badge</small></div>
              </div>
              <div class="form-group"><label class="form-label">Sale price (৳) *</label><input class="form-input" id="pf-price" type="number" min="0" step="0.01" required><small class="form-hint">Customer-facing price — auto-calculated from MRP and discount when both are set</small></div>
              <div class="form-section-title">Internal — admin only</div>
              <div class="form-group"><label class="form-label">Purchase / buy price (৳)</label><input class="form-input" id="pf-buy-price" type="number" min="0" step="0.01" placeholder="Your cost price per unit"><small class="form-hint">Internal use only — not visible to customers on the website</small></div>
              <div class="form-2col">
                <div class="form-group"><label class="form-label">SKU</label><input class="form-input" id="pf-sku" placeholder="PROD-001"></div>
                <div class="form-group"><label class="form-label">Stock</label><input class="form-input" id="pf-stock" type="number" min="0" value="100"></div>
              </div>
              <div class="form-section-title">Content</div>
              <div class="form-group"><label class="form-label">Product specifications</label><textarea class="form-input form-textarea" id="pf-short-desc" rows="8" placeholder="Brand&#9;Brand name&#10;Product weight&#9;100g&#10;Skin Type&#9;Dry&#10;&#10;Tab-separated lines = specification table। Bold, color, highlight formatting ও ব্যবহার করতে পারেন।"></textarea><small class="form-hint">Specification table বা formatted text — Heading, Link, Bold, Italic, Underline, Text color, Highlight supported।</small></div>
              <div class="form-group"><label class="form-label">Description (optional)</label><textarea class="form-input form-textarea" id="pf-desc" rows="5" placeholder="Extra details — care instructions, warranty, shipping notes…"></textarea><small class="form-hint">Heading, Link, Bold, Italic, Underline, Text color, Highlight formatting supported।</small></div>
              <div class="form-section-title">Media</div>
              <div class="form-group">
                <label class="form-label">Product images</label>
                <div class="pf-gallery-list" id="pf-gallery-list"></div>
                <div class="pf-gallery-add-row">
                  <input class="form-input" type="file" id="pf-gallery-files" accept="image/jpeg,image/png,image/webp,image/gif" multiple>
                </div>
                <small class="form-hint">Select multiple files at once. First image = main photo on store &amp; cards (max 12).</small>
                <div class="pf-gallery-url-row">
                  <input class="form-input" id="pf-image-url" placeholder="Or paste image URL and add">
                  <button type="button" class="btn btn-outline btn-sm" id="pf-gallery-url-add">Add URL</button>
                </div>
              </div>
              <div class="form-2col">
                <div class="form-group"><label class="form-label">Icon class</label><input class="form-input" id="pf-icon" placeholder="ti-watch" value="ti-package"></div>
                <div class="form-group"><label class="form-label">Icon color</label><input class="form-input" id="pf-icon-color" value="#2D6B32"></div>
              </div>
              <div class="form-group"><label class="form-label">Background color</label><input class="form-input" id="pf-bg" value="#e8f5e8"></div>
              <div class="form-section-title">Display</div>
              <div class="form-group"><label class="form-label">Tag</label>
                <select class="form-input form-select" id="pf-tag">
                  <option value="none">None</option><option value="discount">Discount</option>
                  <option value="bestseller">Best seller</option><option value="hot">Hot</option><option value="new">New</option>
                </select>
              </div>
              <div class="form-group"><label class="form-label"><input type="checkbox" id="pf-featured" checked> Show on homepage</label></div>
              <details class="form-seo-panel" id="pf-seo-panel">
                <summary class="form-seo-summary"><i class="ti ti-search"></i> SEO &amp; Search (optional)</summary>
                <div class="form-seo-body">
                  <div class="form-group"><label class="form-label">SEO title</label><input class="form-input" id="pf-seo-title" maxlength="255" placeholder="Google search title — leave blank to use product name"></div>
                  <div class="form-group"><label class="form-label">SEO description</label><textarea class="form-input form-textarea" id="pf-seo-desc" rows="2" maxlength="320" placeholder="Meta description for search engines (max ~160 chars shown)"></textarea></div>
                  <div class="form-group"><label class="form-label">SEO keywords</label><input class="form-input" id="pf-seo-keywords" maxlength="255" placeholder="smartwatch, fitness, bangladesh"></div>
                  <div class="form-group"><label class="form-label">Image alt text</label><input class="form-input" id="pf-image-alt" maxlength="255" placeholder="Describe the product image for accessibility &amp; SEO"></div>
                  <div class="form-group"><label class="form-label">Social share image (OG)</label><input class="form-input" id="pf-og-image" placeholder="/uploads/... or full URL — optional, overrides product image"></div>
                </div>
              </details>
              <div class="product-form-actions">
                <button type="submit" class="btn btn-primary"><i class="ti ti-device-floppy"></i> Save Product</button>
                <button type="button" class="btn btn-outline" id="pf-reset">Clear form</button>
                <button type="button" class="btn btn-outline" id="product-form-cancel">Cancel</button>
              </div>
            </form>
          </div>
        </div>
      </div>

      <div class="adm-section" id="sec-customers">
        <div class="stats-grid" style="grid-template-columns:repeat(3,1fr);margin-bottom:20px;" id="customer-stats"></div>
        <div class="table-wrap" style="margin:0;">
          <div class="table-header">
            <h3>Customers</h3>
            <div class="table-actions">
