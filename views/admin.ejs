      <input type="hidden" id="faq-id" value="">
      <div class="form-group"><label class="form-label">Question *</label><input class="form-input" id="faq-question" required maxlength="500" placeholder="How do I place an order?"></div>
      <div class="form-group"><label class="form-label">Answer *</label><textarea class="form-input form-textarea" id="faq-answer" rows="6" placeholder="Write the answer here…"></textarea><small class="form-hint">Format with the toolbar — add links, lists, and bold text easily.</small></div>
      <div class="form-2col">
        <div class="form-group"><label class="form-label">Sort order</label><input class="form-input" id="faq-sort" type="number" min="0" value="0"></div>
        <div class="form-group" style="display:flex;align-items:flex-end;padding-bottom:4px;"><label class="form-label"><input type="checkbox" id="faq-active" checked> Show on FAQ page</label></div>
      </div>
      <div class="modal-box-actions">
        <button type="submit" class="btn btn-primary"><i class="ti ti-device-floppy"></i> Save FAQ</button>
        <button type="button" class="btn btn-outline" id="faq-reset">Clear</button>
        <button type="button" class="btn btn-outline" id="faq-modal-cancel">Cancel</button>
      </div>
    </form>
  </div>
</div>

<div class="modal-overlay" id="review-modal" aria-hidden="true">
  <div class="modal-box modal-box--product" role="dialog" aria-labelledby="review-form-title">
    <div class="modal-box-head">
      <h3 id="review-form-title">Add Review</h3>
      <button type="button" class="modal-box-close" id="review-modal-close" aria-label="Close"><i class="ti ti-x"></i></button>
    </div>
    <form id="review-form">
      <input type="hidden" id="rev-id" value="">
      <input type="hidden" id="rev-product-id" value="">
      <div class="form-group">
        <label class="form-label">Product (search) *</label>
        <input class="form-input" id="rev-product-search" placeholder="Type product name…" autocomplete="off">
        <div class="picker-list" id="rev-product-pick" hidden></div>
        <small class="form-hint" id="rev-product-picked-hint">Select a product from search results.</small>
      </div>
      <div class="form-2col">
        <div class="form-group"><label class="form-label">Customer name *</label><input class="form-input" id="rev-name" required placeholder="e.g. Rafi Ahmed"></div>
        <div class="form-group"><label class="form-label">City</label><input class="form-input" id="rev-city" placeholder="e.g. Dhaka"></div>
      </div>
      <div class="form-2col">
        <div class="form-group"><label class="form-label">Rating *</label>
          <select class="form-input form-select" id="rev-rating" required>
            <option value="5">5</option><option value="4">4</option><option value="3">3</option><option value="2">2</option><option value="1">1</option>
          </select>
        </div>
        <div class="form-group"><label class="form-label">Status</label>
          <select class="form-input form-select" id="rev-status">
            <option value="approved">Approved</option>
            <option value="pending">Pending</option>
            <option value="rejected">Rejected</option>
          </select>
        </div>
      </div>
      <div class="form-group"><label class="form-label">Comment</label><textarea class="form-input form-textarea" id="rev-comment" rows="4" placeholder="Write customer feedback…"></textarea></div>
      <div class="form-group"><label class="form-label">Review photo (optional)</label><input class="form-input" id="rev-image" placeholder="/uploads/... or https://..."></div>
      <div class="form-group"><label class="form-label">Reviewer profile image (avatar)</label><input class="form-input" id="rev-avatar" placeholder="/uploads/... or https://..."></div>
      <div class="form-group"><label class="form-label">Upload avatar image</label><input class="form-input" type="file" id="rev-avatar-file" accept="image/jpeg,image/png,image/webp,image/gif"></div>
      <div id="rev-avatar-preview-wrap" hidden style="margin-bottom:12px;">
        <img id="rev-avatar-preview" alt="Avatar preview" style="max-width:120px;max-height:120px;border-radius:999px;border:1px solid var(--border);object-fit:cover;">
      </div>
      <div class="modal-form-actions">
        <button type="submit" class="btn btn-primary"><i class="ti ti-device-floppy"></i> Save</button>
        <button type="button" class="btn btn-outline" id="rev-reset">Clear</button>
        <button type="button" class="btn btn-outline" id="review-modal-cancel">Cancel</button>
      </div>
    </form>
  </div>
</div>

<div class="modal-overlay" id="gallery-lightbox" aria-hidden="true">
  <div class="gallery-lightbox-dialog" role="dialog" aria-modal="true" aria-labelledby="gallery-lightbox-title">
    <button type="button" class="gallery-lightbox-close" id="gallery-lightbox-close" aria-label="Close"><i class="ti ti-x"></i></button>
    <img id="gallery-lightbox-img" alt="">
    <div class="gallery-lightbox-meta">
      <h3 id="gallery-lightbox-title"></h3>
      <p id="gallery-lightbox-sub"></p>
      <div class="gallery-lightbox-actions">
        <button type="button" class="btn btn-outline btn-sm" id="gallery-lightbox-copy"><i class="ti ti-copy"></i> Copy URL</button>
        <button type="button" class="btn btn-primary btn-sm" id="gallery-lightbox-edit"><i class="ti ti-pencil"></i> Edit product</button>
        <a href="#" class="btn btn-outline btn-sm" id="gallery-lightbox-view" target="_blank" rel="noopener"><i class="ti ti-external-link"></i> View on store</a>
      </div>
    </div>
  </div>
</div>

<div class="modal-overlay" id="order-modal">
  <div class="modal-box">
    <h3>Order Details</h3>
    <div id="order-modal-body"></div>
    <div style="margin-top:16px;display:flex;gap:8px;flex-wrap:wrap;">
      <select class="form-input form-select" id="order-status-select" style="flex:1;min-width:140px;">
        <option value="pending">Pending</option><option value="confirmed">Confirmed</option>
        <option value="shipped">Shipped</option><option value="delivered">Delivered</option><option value="cancelled">Cancelled</option>
      </select>
      <button type="button" class="btn btn-primary" id="order-status-save">Update Status</button>
      <button type="button" class="btn btn-danger" id="order-delete-btn"><i class="ti ti-trash"></i> Delete</button>
      <button type="button" class="btn btn-outline" id="order-modal-close">Close</button>
    </div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>
<script src="/js/admin-rich-editor.js?v=4"></script>
<script src="/js/admin.js?v=95"></script>
</body>
</html>
