                <input class="acc-input" type="password" name="currentPassword" required autocomplete="current-password">
                <button type="button" class="acc-pw-toggle" aria-label="Show password" title="Show password"><i class="ti ti-eye"></i></button>
              </div>
            </div>
            <div class="acc-field">
              <label class="acc-label">New password</label>
              <div class="acc-input-wrap acc-input-wrap--password">
