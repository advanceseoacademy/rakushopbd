.checkout-summary-box { background:var(--surface); border:1px solid var(--border); border-radius:var(--radius-lg); padding:20px; position:sticky; top:80px; height:fit-content; }
.checkout-product-row { display:flex; align-items:center; gap:10px; padding:10px 0; border-bottom:1px solid var(--border); }
