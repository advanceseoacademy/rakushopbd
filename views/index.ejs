<!DOCTYPE html>
<html lang="en-BD">
<head>
<meta charset="UTF-8">
<script>
(function () {
  try {
    var path = (location.pathname || '/').replace(/\/+$/, '') || '/';
    var onAccount = path === '/account';
    var hasCookie = document.cookie.split(';').some(function (c) {
      return c.trim().indexOf('rakushopbd.sid=') === 0;
    });
    var raw = localStorage.getItem('raku_user_session') || sessionStorage.getItem('raku_user_session');
    var user = raw ? JSON.parse(raw) : null;
    if (user && user.id && hasCookie) {
      document.documentElement.classList.add('user-auth-restoring');
    } else if (user && user.id && !hasCookie) {
      try {
        localStorage.removeItem('raku_user_session');
        sessionStorage.removeItem('raku_user_session');
      } catch (_) {}
      if (onAccount) document.documentElement.classList.add('account-auth-pending');
    } else if (hasCookie) {
      document.documentElement.classList.add('user-auth-restoring');
    } else if (onAccount) {
      document.documentElement.classList.add('account-auth-pending');
    }
  } catch (_) {}
})();
</script>
<style>
html.user-auth-restoring #page-account .acc-guest-main { display: none !important; }
html.user-auth-restoring #page-account .acc-user-only { display: grid !important; }
html.account-auth-pending #page-account .acc-guest-main { display: none !important; }
html.account-auth-pending #page-account .acc-user-only { display: none !important; }
</style>
