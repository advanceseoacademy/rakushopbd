                <div class="acc-input-wrap"><i class="ti ti-user"></i><input class="acc-input" type="text" name="fullName" required></div>
              </div>
              <div class="acc-field">
                <label class="acc-label">Phone</label>
                <div class="acc-input-wrap"><i class="ti ti-phone"></i><input class="acc-input" type="tel" name="phone" required></div>
              </div>
            </div>
            <div class="acc-field">
              <label class="acc-label">Email <span class="acc-label-muted">(cannot change)</span></label>
              <div class="acc-input-wrap acc-input-disabled"><i class="ti ti-mail"></i><input class="acc-input" type="email" name="email" disabled></div>
            </div>
            <button type="submit" class="acc-btn acc-btn-primary"><i class="ti ti-device-floppy"></i> Save Changes</button>
          </form>
        </div>
      </section>

      <section class="acc-panel" id="acc-panel-addresses">
        <div class="acc-panel-head">
          <div>
            <h2 class="acc-panel-title">Addresses</h2>
            <p class="acc-panel-sub">Save delivery addresses for faster checkout.</p>
          </div>
        </div>
        <div id="acc-addresses-list"></div>
