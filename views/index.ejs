<!-- AI Skin Scan (YouCam) — Derma-style wizard -->
<button type="button" class="face-analyzer-fab" id="face-analyzer-fab" aria-label="ফ্রি স্কিন টেস্ট" title="ফ্রি স্কিন টেস্ট" style="display:none">
 <span class="face-analyzer-fab-bubble" aria-hidden="true">
  <span class="face-analyzer-fab-popup is-visible" id="fa-fab-popup">
   <span class="face-analyzer-fab-emoji" id="fa-fab-emoji">👋</span>
   <span class="face-analyzer-fab-msg" id="fa-fab-msg">ফ্রি স্কিন টেস্ট...</span>
  </span>
 </span>
 <span class="face-analyzer-fab-avatar" aria-hidden="true">
  <img class="face-analyzer-fab-avatar-img" id="fa-fab-avatar-img" src="/images/skin-scan-avatar-1.jpg" alt="" width="76" height="76" loading="lazy" decoding="async">
  <span class="face-analyzer-fab-scan-ring"></span>
  <span class="face-analyzer-fab-scan-grid"></span>
 </span>
</button>
<div class="face-analyzer-backdrop" id="face-analyzer-backdrop" aria-hidden="true"></div>
<div class="fa-modal" id="fa-modal" role="dialog" aria-labelledby="fa-brand-title" aria-modal="true">
 <button type="button" class="fa-modal-close" id="face-analyzer-close" aria-label="Close"><i class="ti ti-x"></i></button>

 <!-- Step 1: Intro -->
 <div class="fa-step active" id="fa-step-intro" data-step="intro">
  <div class="fa-brand" style="padding-top:28px;">
   <div class="fa-brand-logo" id="fa-brand-title"><span>Raku</span> Scan</div>
  </div>
  <div class="fa-step-split">
   <div class="fa-split-content">
    <p class="fa-eyebrow">Personalized skincare</p>
    <h2 class="fa-title">SKIN ANALYSIS</h2>
    <p class="fa-desc">Analyze your skin concerns, and receive personalized skincare product recommendations.</p>
    <button type="button" class="fa-btn-primary" id="fa-btn-start">START</button>
   </div>
   <div class="fa-split-visual">
    <div class="fa-visual-bg" aria-hidden="true"></div>
    <div class="fa-phone-mock" aria-hidden="true">
     <div class="fa-phone-screen">
      <span style="margin-top:12px;font-size:7px;letter-spacing:0.1em;">FACE SCAN IN PROGRESS</span>
      <div class="scan-line"></div>
      <div class="fa-phone-metrics">
       <div>Skin Score <b>89</b> · Skin Age <b>30</b></div>
       <div style="display:flex;justify-content:space-around;margin-top:6px;">
        <span><b>86</b><br>Spots</span><span><b>76</b><br>Oil</span><span><b>95</b><br>Acne</span><span><b>79</b><br>Pores</span>
       </div>
      </div>
     </div>
    </div>
   </div>
  </div>
 </div>

 <!-- Step 2: Instructions -->
 <div class="fa-step" id="fa-step-instructions" data-step="instructions">
  <div class="fa-brand" style="padding-top:20px;">
   <div class="fa-brand-logo"><span>Raku</span> Scan</div>
  </div>
  <div class="fa-step-split">
   <div class="fa-split-content">
    <p class="fa-eyebrow">Get Ready to Start Skin Analysis</p>
    <h2 class="fa-title dark">INSTRUCTIONS</h2>
    <ul class="fa-instruction-list">
     <li><span class="fa-instruction-icon"><i class="ti ti-glasses-off"></i></span><span>Take off your glasses and ensure there's no bangs on your forehead.</span></li>
     <li><span class="fa-instruction-icon"><i class="ti ti-bulb"></i></span><span>Make sure that you're in a well-lighted environment.</span></li>
     <li><span class="fa-instruction-icon"><i class="ti ti-lipstick"></i></span><span>Testing with no-makeup will get more accurate results.</span></li>
     <li><span class="fa-instruction-icon"><i class="ti ti-user-circle"></i></span><span>Looking straight to the camera and keep your face in the circle.</span></li>
    </ul>
    <button type="button" class="fa-btn-primary" id="fa-btn-get-started" style="width:100%;max-width:280px;">GET STARTED</button>
   </div>
   <div class="fa-split-visual">
    <div class="fa-visual-bg" aria-hidden="true"></div>
    <div style="position:relative;z-index:2;text-align:center;color:#1e3a5f;font-size:13px;font-weight:600;padding:20px;">
     <i class="ti ti-scan" style="font-size:48px;color:#5eb8d4;display:block;margin-bottom:12px;"></i>
     Position your face in the guide during scan
    </div>
   </div>
  </div>
 </div>

 <!-- Step 3: Loading -->
 <div class="fa-step fa-step-loading" id="fa-step-loading" data-step="loading">
  <div class="fa-loading-logo"><span>Raku</span> Scan</div>
  <p class="fa-loading-sub">AI SKIN ANALYZER</p>
  <div class="fa-ai-chip">AI</div>
  <p class="fa-powered">Powered by <b>PERFECT</b> <a href="https://yce.perfectcorp.com/" target="_blank" rel="noopener noreferrer" style="color:inherit;"><i class="ti ti-external-link"></i></a></p>
 </div>

 <!-- Step 4: Live scan -->
 <div class="fa-step fa-step-scan" id="fa-step-scan" data-step="scan">
  <div class="fa-scan-video-wrap">
   <video id="face-analyzer-video" playsinline autoplay muted aria-label="Live camera preview"></video>
  </div>
  <div class="fa-scan-overlay">
   <div class="fa-scan-badge" id="fa-scan-badge">POSITION YOUR FACE IN THE CIRCLE</div>
   <div class="fa-scan-face-guide" aria-hidden="true"></div>
   <div class="fa-scan-line-live" aria-hidden="true"></div>
   <div class="fa-scan-countdown" id="fa-scan-countdown" aria-live="polite" hidden></div>
  </div>
  <div class="fa-scan-actions">
   <button type="button" class="fa-scan-btn fa-scan-btn-outline" id="fa-btn-upload-fallback">Upload photo</button>
  </div>
  <input type="file" id="face-analyzer-file" accept="image/jpeg,image/jpg,image/png" hidden>
 </div>

 <!-- Step 5: Results -->
 <div class="fa-step fa-step-results" id="fa-step-results" data-step="results">
  <div class="fa-brand" style="padding-top:8px;margin-bottom:8px;">
   <div class="fa-brand-logo" style="font-size:28px;"><span>Raku</span> Scan</div>
  </div>
  <h2 class="fa-title dark" style="font-size:18px;margin-bottom:8px;">YOUR ANALYSIS</h2>
  <div class="fa-status-msg" id="face-analyzer-status"></div>
  <div id="face-analyzer-results"></div>
  <button type="button" class="fa-btn-primary" id="fa-btn-scan-again" style="margin-top:16px;">SCAN AGAIN</button>
 </div>
</div>

