      <div id="appt-book-success" class="appt-success" hidden></div>
      <button type="submit" class="appt-btn" id="appt-book-btn"><i class="ti ti-calendar-check"></i> Book appointment</button>
     </form>
    </div>
    <div class="appt-panel" id="appt-panel-lookup" role="tabpanel" hidden>
     <form class="appt-form" id="appt-lookup-form" novalidate>
      <div class="appt-field">
       <label for="appt-lookup-ref">Reference number *</label>
       <input type="text" id="appt-lookup-ref" placeholder="APT-2026-........" autocomplete="off">
      </div>
      <div class="appt-field">
       <label for="appt-lookup-phone">Mobile number *</label>
       <input type="tel" id="appt-lookup-phone" placeholder="01XXXXXXXXX" autocomplete="tel">
      </div>
      <div id="appt-lookup-error" class="appt-err" hidden></div>
      <div id="appt-lookup-result" hidden></div>
      <button type="submit" class="appt-btn appt-btn-outline" id="appt-lookup-btn"><i class="ti ti-search"></i> Check appointment</button>
     </form>
    </div>
   </div>
  </div>
  <div class="appt-card">
   <div class="appt-head">
    <h2 class="appt-title"><i class="ti ti-info-circle"></i> How it works</h2>
    <p class="appt-sub">Free appointment for product guidance, beauty advice, or order collection at RakuShopBD.</p>
   </div>
   <div class="appt-body">
    <div class="appt-step"><i class="ti ti-forms"></i><div><b>1) Fill the form</b><span>Name, phone, service, date and time slot.</span></div></div>
    <div class="appt-step"><i class="ti ti-phone"></i><div><b>2) We confirm</b><span>Our team calls or SMS you within 24 hours.</span></div></div>
    <div class="appt-step"><i class="ti ti-calendar-check"></i><div><b>3) Visit or call</b><span>Come at your slot or join the scheduled support call.</span></div></div>
    <div class="appt-step"><i class="ti ti-receipt"></i><div><b>Save your reference</b><span>Use APT-2026-... + phone to check status anytime.</span></div></div>
   </div>
  </div>
 </div>
</div>
