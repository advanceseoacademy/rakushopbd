              <div class="acc-field">
                <label class="acc-label">Label</label>
                <div class="acc-input-wrap"><i class="ti ti-tag"></i>
                  <select class="acc-input" name="label"><option>Home</option><option>Office</option><option>Other</option></select>
                </div>
              </div>
              <div class="acc-field">
                <label class="acc-label">District</label>
                <div class="acc-input-wrap"><i class="ti ti-map"></i>
                  <select class="acc-input" name="district" required>
                    <option value="">Select district</option>
                    <option>Dhaka</option><option>Chittagong</option><option>Sylhet</option>
                    <option>Rajshahi</option><option>Khulna</option><option>Barishal</option>
                    <option>Rangpur</option><option>Mymensingh</option>
                  </select>
                </div>
              </div>
              <div class="acc-field">
                <label class="acc-label">Postal code</label>
                <div class="acc-input-wrap"><i class="ti ti-mailbox"></i><input class="acc-input" type="text" name="postalCode" placeholder="1200"></div>
              </div>
            </div>
            <div class="acc-field-row">
              <div class="acc-field">
                <label class="acc-label">Full name</label>
                <div class="acc-input-wrap"><i class="ti ti-user"></i><input class="acc-input" type="text" name="fullName" required></div>
              </div>
              <div class="acc-field">
                <label class="acc-label">Phone</label>
                <div class="acc-input-wrap"><i class="ti ti-phone"></i><input class="acc-input" type="tel" name="phone" required></div>
              </div>
            </div>
            <div class="acc-field">
              <label class="acc-label">Thana / Upazila</label>
              <div class="acc-input-wrap"><i class="ti ti-building-community"></i><input class="acc-input" type="text" name="thana" placeholder="Area name"></div>
            </div>
            <div class="acc-field">
              <label class="acc-label">Full address</label>
              <div class="acc-input-wrap acc-textarea-wrap"><i class="ti ti-home"></i><textarea class="acc-input" name="addressLine" rows="2" placeholder="House, road, area..." required></textarea></div>
            </div>
            <label class="acc-checkbox"><input type="checkbox" name="isDefault"><span class="acc-checkbox-box"></span><span>Set as default address</span></label>
