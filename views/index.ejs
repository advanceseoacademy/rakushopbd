<!-- ===================================================
 PRODUCT VIEW PAGE
=================================================== -->
<div id="page-product" style="display:none;">
<style>
#page-product { padding-top: 4px; }
.pv-breadcrumb { max-width:1200px; margin:0 auto; padding:12px 20px 0; display:flex; align-items:center; gap:6px; font-size:12px; color:var(--text-muted); flex-wrap:wrap; }
.pv-breadcrumb a { color:var(--text-muted); text-decoration:none; cursor:pointer; }
.pv-breadcrumb a:hover { color:var(--primary); }
.pv-breadcrumb i { font-size:11px; }
.pv-wrap { max-width:1200px; margin:0 auto; padding:12px 20px 32px; display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:32px; align-items:start; }
@media(max-width:768px){ .pv-wrap { grid-template-columns:1fr; gap:20px; } }
@media(max-width:480px){ .pv-action-row { flex-direction:column; } .btn-add-cart,.btn-buy,.btn-preorder { width:100%; } .main-product-img { height:240px; } .pv-price { font-size:22px; } .pv-price-row { padding:6px 12px; margin-bottom:10px; } }

/* Gallery */
.pv-gallery {}
.main-product-img {
 width:100%; height:360px; border-radius:var(--radius-xl); background:#e8f5e8;
 display:flex; align-items:center; justify-content:center; margin-bottom:12px;
 border:1px solid var(--border); position:relative; overflow:hidden;
}
.main-product-img i { font-size:140px; color:#2d8a2d; }
.pv-badge-row { position:absolute; top:14px; left:14px; display:flex; gap:6px; }
.pv-badge { background:var(--accent); color:#fff; font-size:11px; font-weight:700; padding:4px 10px; border-radius:20px; }
.pv-badge-new { background:var(--green); }
.thumb-row { display:flex; gap:8px; }
.thumb-img {
 width:72px; height:72px; border-radius:var(--radius-md); border:2px solid transparent;
 display:flex; align-items:center; justify-content:center; cursor:pointer; transition:border-color 0.15s;
 flex-shrink:0;
}
.thumb-img.active, .thumb-img:hover { border-color:var(--primary); }
.thumb-img i { font-size:30px; }
.thumb-img img { width:100%; height:100%; object-fit:cover; border-radius:inherit; display:block; }

/* Info */
.pv-info { min-width: 0; }
.pv-cat { font-size:11px; color:var(--text-light); text-transform:uppercase; letter-spacing:0.5px; margin-bottom:6px; }
.pv-title { font-size:22px; font-weight:700; color:var(--text); line-height:1.35; margin-bottom:10px; word-break:break-word; }
.pv-rating-row { display:flex; align-items:center; gap:10px; margin-bottom:14px; }
.pv-stars { color:#EF9F27; font-size:16px; }
.pv-rating-num { font-size:14px; font-weight:600; }
.pv-reviews { font-size:12px; color:var(--text-muted); }
.pv-sold { font-size:12px; color:var(--green); font-weight:600; background:var(--green-pale); padding:3px 10px; border-radius:20px; }
.pv-specs-inline {
  margin: 4px 0 16px;
}
.pv-specs-inline[hidden] {
  display: none !important;
}
.pv-specs-inline .product-desc-spec {
  margin: 0;
  border: 1px solid #e5e7eb;
  border-radius: var(--radius-md);
  overflow: hidden;
  background: #fff;
}
.pv-specs-inline .spec-table {
  font-size: 13px;
}
.pv-specs-inline .spec-table th {
  width: 36%;
  min-width: 120px;
  padding: 10px 14px;
  background: #f9fafb;
  color: var(--text);
  font-weight: 600;
  vertical-align: top;
}
.pv-specs-inline .spec-table td {
  padding: 10px 14px;
  color: var(--text);
  line-height: 1.5;
  word-break: break-word;
}
.pv-specs-inline .spec-table tr:nth-child(even) td {
  background: #fff;
}
.pv-specs-inline .spec-table tr:nth-child(even) th {
  background: #f3f4f6;
}
.pv-price-row {
 display:inline-flex; align-items:center; flex-wrap:wrap; gap:8px;
 margin-bottom:12px; padding:8px 14px; max-width:100%;
 background:var(--surface2); border-radius:var(--radius-md); border:1px solid var(--border);
}
.pv-price { font-size:26px; font-weight:700; color:var(--accent); line-height:1.1; }
.pv-old-price { font-size:14px; color:var(--text-light); text-decoration:line-through; }
.pv-discount-badge { background:var(--accent-light); color:var(--accent-dark); font-size:11px; font-weight:700; padding:3px 8px; border-radius:20px; }

.variant-label { font-size:12px; font-weight:600; color:var(--text-muted); margin-bottom:8px; text-transform:uppercase; letter-spacing:0.3px; }

.pv-qty-row { display:flex; align-items:center; gap:12px; margin-bottom:18px; }
.qty-control { display:flex; align-items:center; border:1.5px solid var(--border); border-radius:var(--radius-sm); overflow:hidden; }
.qty-btn { width:36px; height:36px; border:none; background:var(--surface2); cursor:pointer; font-size:18px; display:flex; align-items:center; justify-content:center; transition:background 0.15s; }
.qty-btn:hover { background:var(--primary-pale); color:var(--primary); }
.qty-input { width:48px; height:36px; border:none; border-left:1.5px solid var(--border); border-right:1.5px solid var(--border); text-align:center; font-family:inherit; font-size:14px; font-weight:600; background:#fff; outline:none; }
.pv-stock { font-size:12px; color:var(--green); display:flex; align-items:center; gap:4px; }
.pv-stock i { font-size:14px; }

.pv-action-row { display:flex; gap:10px; margin-bottom:20px; }
.btn-add-cart[hidden],
.btn-buy[hidden],
.btn-preorder[hidden] { display:none !important; }
.btn-add-cart {
 flex:1; background:var(--primary); color:#fff; border:none; padding:14px 20px;
 border-radius:var(--radius-md); font-size:15px; font-weight:600; cursor:pointer;
 display:flex; align-items:center; justify-content:center; gap:8px; font-family:inherit;
 transition:background 0.15s, transform 0.1s;
}
.btn-add-cart:hover { background:var(--primary-light); transform:translateY(-1px); }
.btn-buy { flex:1; background:var(--accent); color:#fff; border:none; padding:14px 20px; border-radius:var(--radius-md); font-size:15px; font-weight:600; cursor:pointer; display:flex; align-items:center; justify-content:center; gap:8px; font-family:inherit; transition:background 0.15s, transform 0.1s; }
.btn-buy:hover { background:var(--accent-dark); transform:translateY(-1px); }
.btn-preorder { flex:1; background:#d97706; color:#fff; border:none; padding:14px 20px; border-radius:var(--radius-md); font-size:15px; font-weight:600; cursor:pointer; display:flex; align-items:center; justify-content:center; gap:8px; font-family:inherit; transition:background 0.15s, transform 0.1s; }
.btn-preorder:hover { background:#b45309; transform:translateY(-1px); }
.btn-wish-lg { width:50px; height:50px; border-radius:var(--radius-md); border:1.5px solid var(--border); background:var(--surface); cursor:pointer; display:flex; align-items:center; justify-content:center; flex-shrink:0; transition:all 0.15s; }
.btn-wish-lg:hover { border-color:var(--accent); background:var(--accent-light); }
.btn-wish-lg i { font-size:22px; color:var(--text-muted); }

.pv-meta { display:flex; flex-direction:column; gap:8px; margin-bottom:14px; }
.pv-meta-row { display:flex; align-items:center; gap:8px; font-size:13px; }
.pv-meta-row i { font-size:16px; color:var(--primary); }
.pv-meta-label { color:var(--text-muted); min-width:90px; }
.pv-meta-val { color:var(--text); font-size:13px; font-weight:600; word-break:break-word; }

.pv-delivery-box { background:var(--surface2); border:1px solid var(--border); border-radius:var(--radius-md); padding:14px 16px; margin-bottom:16px; }
.pv-delivery-title { font-size:13px; font-weight:600; margin-bottom:8px; display:flex; align-items:center; gap:6px; }
.pv-delivery-title i { color:var(--primary); }
.pv-delivery-item { display:flex; align-items:center; gap:8px; font-size:12px; color:var(--text-muted); padding:5px 0; border-bottom:1px solid var(--border); }
.pv-delivery-item:last-child { border:none; padding-bottom:0; }
.pv-delivery-item i { color:var(--green); font-size:14px; }

/* Tabs */
.pv-tabs-wrap { max-width:1200px; margin:0 auto; padding:0 20px 32px; }
.tabs-nav { display:flex; border-bottom:2px solid var(--border); margin-bottom:20px; overflow-x:auto; }
.tab-btn[hidden] { display: none !important; }
.tab-btn { padding:12px 20px; font-size:14px; font-family:inherit; background:none; border:none; cursor:pointer; color:var(--text-muted); border-bottom:2px solid transparent; margin-bottom:-2px; white-space:nowrap; transition:all 0.15s; }
.tab-btn.active { color:var(--primary); border-bottom-color:var(--primary); font-weight:600; }
.tab-pane { animation:fadeIn 0.2s; }
@keyframes fadeIn { from{opacity:0;transform:translateY(6px)} to{opacity:1;transform:none} }

/* Description tab */
.product-desc-prose { font-size:14px; color:var(--text-muted); line-height:1.8; margin-bottom:16px; }
.product-desc-spec { border:1px solid var(--border); border-radius:var(--radius-md); overflow:hidden; margin-top:4px; }
.spec-table { width:100%; border-collapse:collapse; font-size:13px; margin:0; }
.spec-table tr:nth-child(even) td { background:var(--surface); }
.spec-table th,
.spec-table td { padding:11px 16px; border-bottom:1px solid var(--border); text-align:left; vertical-align:top; }
.spec-table tr:last-child th,
.spec-table tr:last-child td { border-bottom:none; }
.spec-table th { font-weight:600; color:var(--text); width:34%; min-width:140px; background:var(--surface2); border-right:1px solid var(--border); }
.spec-table td { color:var(--text-muted); line-height:1.55; }

/* Related Products */
.related-section { max-width:1200px; margin:0 auto; padding:0 20px 40px; }
</style>

