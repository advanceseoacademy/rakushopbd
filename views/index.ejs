<% if (typeof bootstrapJson !== 'undefined' && bootstrapJson) { %>
<script>window.__RAKU_BOOTSTRAP=<%- bootstrapJson %>;</script>
<% } %>
<% if (typeof productJson !== 'undefined' && productJson) { %>
<script>window.__RAKU_PRELOAD_PRODUCT=<%- productJson %>;</script>
<script>
(function () {
  var pre = window.__RAKU_PRELOAD_PRODUCT;
  if (!pre || !pre.ok || !pre.product) return;
  var m = (location.pathname || '').match(/^\/product\/([^/]+)\/?$/);
  if (!m) return;
  var ref = decodeURIComponent(m[1]);
  var p = pre.product;
  var match = /^\d+$/.test(ref) ? Number(p.id) === Number(ref) : p.slug === ref;
  if (!match) return;
  var url = String(p.image_url || p.imageUrl || '').trim();
  var titleEl = document.querySelector('#page-product .pv-title');
  if (titleEl) titleEl.textContent = p.name_bn || p.nameBn || titleEl.textContent;
  var priceEl = document.querySelector('#page-product .pv-price');
  if (priceEl && (p.price != null)) {
    priceEl.textContent = '৳' + Number(p.price).toLocaleString('en-BD');
  }
  var descEl = document.getElementById('tab-desc-content');
  var longDesc = String(p.description_bn || p.descriptionBn || '').trim();
  if (descEl && longDesc) {
    if (window._rakuNormalizeProductDescriptionHtml) {
      longDesc = window._rakuNormalizeProductDescriptionHtml(longDesc);
    } else if (longDesc.indexOf('<') >= 0 && /\n/.test(longDesc)) {
      longDesc = longDesc.replace(/\r\n/g, '\n').replace(/\n/g, '<br>');
    }
    var descBody = longDesc.indexOf('<') >= 0
      ? '<div class="product-desc-rich">' + longDesc + '</div>'
      : '<p class="product-desc-prose">' + longDesc + '</p>';
    descEl.innerHTML = '<h3 class="pv-additional-details-heading">Additional Details</h3>' + descBody;
  }
  if (!url) return;
  var main = document.querySelector('#page-product .main-product-img');
  if (!main) return;
  main.querySelectorAll(':scope > i').forEach(function (i) { i.remove(); });
  var img = main.querySelector('img.product-photo');
  if (!img) {
    img = document.createElement('img');
    img.className = 'product-photo';
    img.style.cssText = '';
    img.loading = 'eager';
    img.decoding = 'async';
    main.appendChild(img);
  }
  if (url.charAt(0) === '/') img.src = url;
  else if (/^https?:\/\//i.test(url)) img.src = url;
  else img.src = '/' + url;
  img.alt = String(p.image_alt || p.imageAlt || p.name_bn || p.nameBn || 'Product').trim();
  var bg = p.bg_color || p.bgColor;
  if (bg) main.style.background = bg;
  var urls = Array.isArray(p.gallery_urls) ? p.gallery_urls.filter(Boolean) : [];
  if (!urls.length && url) urls = [url];
  else if (url && urls.indexOf(url) < 0) urls.unshift(url);
  var thumbRow = document.querySelector('#page-product .thumb-row');
  if (thumbRow && urls.length > 1) {
    thumbRow.style.display = '';
    thumbRow.innerHTML = urls.map(function (u, i) {
      var src = u.charAt(0) === '/' ? u : (/^https?:\/\//i.test(u) ? u : '/' + u);
      var active = i === 0 ? ' active' : '';
      return '<div class="thumb-img' + active + '" data-url="' + encodeURIComponent(src) + '" style="background:' + (bg || '#f5f5f5') + ';"><img src="' + src + '" alt="" width="72" height="72" loading="lazy" decoding="async"></div>';
    }).join('');
  }
})();
</script>
<% } %>
