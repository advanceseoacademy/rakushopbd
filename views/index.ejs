        <input type="date" id="appt-date" name="date" required>
       </div>
       <div class="appt-field">
        <label for="appt-time">Time slot *</label>
        <select id="appt-time" name="time" required></select>
       </div>
      </div>
      <div class="appt-field">
       <label for="appt-notes">Notes (optional)</label>
       <textarea id="appt-notes" name="notes" rows="3" placeholder="Product name, skin type, or any question..."></textarea>
