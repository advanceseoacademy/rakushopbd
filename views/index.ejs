<div id="page-checkout" style="display:none;">
<div class="checkout-page">
  <div class="checkout-page-head">
    <button type="button" class="checkout-page-back" id="checkout-back-cart" aria-label="Back to cart">
      <i class="ti ti-arrow-left" aria-hidden="true"></i>
      <span>Back to cart</span>
    </button>
    <h1 class="checkout-page-title"><i class="ti ti-shopping-cart-check"></i> Checkout</h1>
  </div>

  <div class="checkout-steps checkout-page-steps">
    <div class="step-item step-done"><div class="step-circle"><i class="ti ti-check" style="font-size:14px;"></i></div><span class="step-label">Cart</span></div>
    <div class="step-line step-line-done"></div>
    <div class="step-item step-active"><div class="step-circle">2</div><span class="step-label">Checkout</span></div>
    <div class="step-line"></div>
    <div class="step-item step-inactive"><div class="step-circle">3</div><span class="step-label">Confirmation</span></div>
  </div>

  <div class="checkout-page-grid">
    <form class="checkout-page-form checkout-modal-form" id="checkout-page-form" onsubmit="return false;">
      <div class="cm-section">
        <div class="cm-section-title"><i class="ti ti-user"></i> Contact &amp; delivery</div>
        <div class="cm-row">
          <div class="cm-field">
            <label class="cm-label" for="cm-name">Full name *</label>
            <input class="cm-input" id="cm-name" name="name" type="text" placeholder="e.g. Rafi Ahmed" required>
          </div>
          <div class="cm-field">
            <label class="cm-label" for="cm-phone">Mobile number *</label>
            <input class="cm-input" id="cm-phone" name="phone" type="tel" placeholder="e.g. 01712345678" required>
          </div>
        </div>
        <div class="cm-row cm-row-1">
          <div class="cm-field">
            <label class="cm-label" for="cm-address">Full address *</label>
            <textarea class="cm-input" id="cm-address" name="address" rows="2" placeholder="e.g. House 12, Road 5, Dhanmondi, Dhaka" required style="resize:none;"></textarea>
          </div>
        </div>
        <div class="cm-row cm-row-1">
          <div class="cm-field">
            <span class="cm-label">Delivery area *</span>
            <div class="checkout-zone-grid" id="checkout-page-zone-grid" role="group" aria-label="Delivery area">
              <input type="hidden" name="district" id="checkout-page-district" value="Dhaka">
              <button type="button" class="checkout-zone-tile selected" data-district="Dhaka">Inside Dhaka</button>
              <button type="button" class="checkout-zone-tile" data-district="Outside Dhaka">Outside Dhaka</button>
            </div>
            <small class="checkout-zone-hint" id="checkout-page-zone-hint"></small>
          </div>
        </div>
      </div>

      <div class="cm-section cm-payment-block">
        <h3 class="cm-pay-heading">Choose payment method</h3>
        <p class="cm-pay-subtitle">Pay manually — use any method below</p>
        <div class="cm-pay-grid-2" id="cm-pay-grid" role="group" aria-label="Payment method">
          <input type="hidden" name="paymethod" id="cm-paymethod-value" value="bkash">
          <button type="button" class="cm-pay-tile selected" data-method="bkash">bKash</button>
          <button type="button" class="cm-pay-tile" data-method="nagad">Nagad</button>
          <button type="button" class="cm-pay-tile" data-method="rocket">Rocket</button>
          <button type="button" class="cm-pay-tile" data-method="cod">COD</button>
        </div>
        <div class="cm-pay-instruct-box" id="cm-pay-instruct-box">
          <div class="cm-pay-instruct-label">Instructions</div>
          <p class="cm-pay-instruct-text" id="cm-pay-instruct-text"></p>
          <div class="cm-pay-number" id="cm-pay-number" hidden></div>
          <p class="cm-pay-instruct-hint" id="cm-pay-instruct-hint"></p>
        </div>
        <div class="cm-field cm-trx-field" id="cm-trx-wrap">
          <label class="cm-label" for="cm-trxid">Transaction ID (TrxID) *</label>
          <input class="cm-input" id="cm-trxid" name="trxid" type="text" placeholder="e.g. 8A7K9X2M" autocomplete="off">
        </div>
      </div>

      <div class="cm-section">
        <div class="cm-section-title"><i class="ti ti-notes"></i> Order notes (optional)</div>
        <textarea class="cm-input" id="cm-notes" name="notes" rows="2" placeholder="e.g. Call before delivery, evening preferred" style="width:100%;resize:none;"></textarea>
      </div>
    </form>

    <aside class="checkout-page-summary checkout-modal-summary">
      <h3>Order summary</h3>
      <div id="checkout-page-items"></div>
      <div class="cm-summary-rows">
        <div class="cm-summary-row"><span>Subtotal</span><span class="summary-subtotal">৳0</span></div>
        <div class="cm-summary-row"><span>Delivery</span><span class="summary-delivery">Free</span></div>
        <div class="cm-summary-row cm-reward-points-row" id="checkout-reward-points-row" hidden>
          <span><i class="ti ti-award"></i> Reward points <small style="font-weight:500;opacity:.85;">(after delivery)</small></span>
          <span class="summary-reward-points" id="checkout-reward-points">0</span>
        </div>
        <div class="c-coupon-row cm-coupon-row">
          <input class="c-coupon-input js-coupon-input" type="text" placeholder="Coupon code" autocomplete="off">
          <button type="button" class="c-coupon-btn js-coupon-apply">Apply</button>
          <button type="button" class="c-coupon-remove js-coupon-remove" hidden>Remove</button>
        </div>
        <div class="cm-summary-row cm-total"><span>Total</span><span class="summary-total">৳0</span></div>
      </div>
      <button type="button" class="btn-place-order-modal" id="btn-place-order">
        <i class="ti ti-lock"></i> Place order
      </button>
      <p class="cm-secure"><i class="ti ti-shield-check"></i> Secure checkout</p>
      <p class="checkout-page-legal">By placing an order you agree to our <a href="/terms-and-conditions">Terms</a> and <a href="/privacy-policy">Privacy Policy</a>.</p>
    </aside>
  </div>
</div>
