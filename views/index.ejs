<!-- ===================================================
 ORDER SUCCESS PAGE
=================================================== -->
<div id="page-success" style="display:none;">
<style>
.success-wrap { max-width:640px; margin:40px auto; padding:0 20px 60px; text-align:center; }
.success-icon-ring { width:100px; height:100px; border-radius:50%; background:var(--green-pale); border:4px solid var(--green); display:flex; align-items:center; justify-content:center; margin:0 auto 24px; animation:popIn 0.5s cubic-bezier(.17,.89,.32,1.5); }
@keyframes popIn { from{transform:scale(0)} to{transform:scale(1)} }
.success-icon-ring i { font-size:52px; color:var(--green); }
.success-title { font-size:28px; font-weight:700; color:var(--text); margin-bottom:8px; }
.success-sub { font-size:15px; color:var(--text-muted); margin-bottom:24px; line-height:1.6; }
.order-id-box { display:inline-flex; align-items:center; gap:8px; background:var(--primary-pale); border:1.5px solid var(--primary); border-radius:var(--radius-md); padding:10px 20px; font-size:14px; font-weight:700; color:var(--primary); margin-bottom:28px; }
.success-steps { display:grid; grid-template-columns:repeat(3,1fr); gap:16px; margin-bottom:28px; text-align:center; }
@media(max-width:600px){ .success-steps { grid-template-columns:1fr; } .success-title { font-size:22px; } }
.success-step-card { background:var(--surface); border:1px solid var(--border); border-radius:var(--radius-lg); padding:18px 12px; }
.success-step-num { width:32px; height:32px; border-radius:50%; background:var(--primary); color:#fff; font-size:14px; font-weight:700; display:flex; align-items:center; justify-content:center; margin:0 auto 8px; }
.success-step-title { font-size:12px; font-weight:600; color:var(--text); margin-bottom:3px; }
.success-step-sub { font-size:11px; color:var(--text-muted); }
.success-actions { display:flex; gap:12px; justify-content:center; flex-wrap:wrap; }
.btn-track { background:var(--primary); color:#fff; border:none; padding:13px 28px; border-radius:var(--radius-md); font-size:14px; font-weight:600; cursor:pointer; font-family:inherit; display:flex; align-items:center; gap:8px; transition:background 0.15s; }
.btn-track:hover { background:var(--primary-light); }
.btn-home-again { background:var(--surface); color:var(--primary); border:1.5px solid var(--primary); padding:13px 28px; border-radius:var(--radius-md); font-size:14px; font-weight:600; cursor:pointer; font-family:inherit; display:flex; align-items:center; gap:8px; transition:background 0.15s; }
.btn-home-again:hover { background:var(--primary-pale); }
.success-facebook-box {
  background: linear-gradient(135deg, #eff6ff 0%, #f0fdf4 100%);
  border: 1px solid #bfdbfe;
  border-radius: var(--radius-lg);
  padding: 18px 20px;
  margin-bottom: 24px;
  text-align: left;
}
.success-facebook-box h3 {
  font-size: 15px;
  font-weight: 700;
  color: var(--text);
  margin: 0 0 8px;
  display: flex;
  align-items: center;
  gap: 8px;
}
.success-facebook-box h3 i { color: #1877f2; font-size: 20px; }
.success-facebook-box p {
  font-size: 13px;
  color: var(--text-muted);
  line-height: 1.6;
  margin: 0 0 14px;
}
.success-facebook-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: #1877f2;
  color: #fff;
  text-decoration: none;
