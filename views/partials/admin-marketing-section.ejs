      <div class="adm-section" id="sec-marketing">
        <div class="settings-page marketing-admin-page">
          <div class="settings-page-head">
            <div>
              <h2 class="settings-page-title">Marketing &amp; Homepage</h2>
              <p class="settings-page-desc">Homepage hero, deals, promo cards, and phone subscribers — organized by tab. Each area has its own save button.</p>
            </div>
          </div>

          <nav class="settings-tabs" role="tablist" aria-label="Marketing sections">
            <button type="button" class="settings-tab active" data-marketing-tab="hero" role="tab"><i class="ti ti-photo"></i><span>Hero Slider</span></button>
            <button type="button" class="settings-tab" data-marketing-tab="deals" role="tab"><i class="ti ti-flame"></i><span>Today Deals</span></button>
            <button type="button" class="settings-tab" data-marketing-tab="promo" role="tab"><i class="ti ti-layout-cards"></i><span>Promo Cards</span></button>
            <button type="button" class="settings-tab" data-marketing-tab="popups" role="tab"><i class="ti ti-layout"></i><span>Popups</span></button>
            <button type="button" class="settings-tab" data-marketing-tab="subscribers" role="tab"><i class="ti ti-phone"></i><span>Subscribers</span></button>
          </nav>

          <!-- Hero slider -->
          <div class="settings-panel active" id="marketing-panel-hero" role="tabpanel">
            <div class="settings-card">
              <div class="settings-card-head">
                <div class="settings-card-icon settings-card-icon--green"><i class="ti ti-photo"></i></div>
                <div>
                  <h3 class="settings-card-title">Hero banner slider</h3>
                  <p class="settings-card-desc">Full-width homepage hero — upload multiple images; they auto-slide.</p>
                </div>
              </div>
              <div class="settings-card-body">
                <div class="settings-row" style="margin-bottom:16px;">
                  <div><div>Show banner slider</div><div class="settings-row-info">Replaces single banner when slides are saved</div></div>
                  <label class="toggle"><input type="checkbox" id="hero-slider-enabled" checked><span class="toggle-slider"></span></label>
                </div>
                <div class="form-group">
                  <label class="form-label">Slide interval (seconds)</label>
                  <input class="form-input" type="number" id="hero-slider-interval" min="3" max="12" value="4.5" step="0.5" style="max-width:160px;">
                </div>
                <div class="settings-subsection-label"><i class="ti ti-stack-2"></i> Slides</div>
                <div id="hero-slider-slides"></div>
                <button type="button" class="btn btn-outline btn-sm" id="hero-slider-add-btn" style="margin-top:12px;"><i class="ti ti-plus"></i> Add slide</button>
              </div>
              <div class="settings-card-foot">
                <button type="button" class="btn btn-primary" id="hero-slider-save-btn"><i class="ti ti-device-floppy"></i> Save Hero Slider</button>
              </div>
            </div>
          </div>

          <!-- Today Deals -->
          <div class="settings-panel" id="marketing-panel-deals" role="tabpanel">
            <div class="settings-card">
              <div class="settings-card-head">
                <div class="settings-card-icon settings-card-icon--amber"><i class="ti ti-flame"></i></div>
                <div>
                  <h3 class="settings-card-title">Today Deals</h3>
                  <p class="settings-card-desc">Hot-deals style product row with countdown timer next to the title.</p>
                </div>
              </div>
              <div class="settings-card-body">
                <div class="settings-row" style="margin-bottom:16px;">
                  <div><div>Show Today Deals</div><div class="settings-row-info">Hidden automatically when timer ends</div></div>
                  <label class="toggle"><input type="checkbox" id="td-enabled" checked><span class="toggle-slider"></span></label>
                </div>
                <div class="form-2col">
                  <div class="form-group">
                    <label class="form-label">Section title</label>
                    <input class="form-input" id="td-title" value="Today Deals">
                  </div>
                  <div class="form-group">
                    <label class="form-label">Deal ends at</label>
                    <input class="form-input" type="datetime-local" id="td-ends-at">
                  </div>
                </div>
                <div class="form-group">
                  <label class="form-label">Products (max 12)</label>
                  <div id="today-deals-products" class="today-deals-admin-products marketing-checklist"></div>
                </div>
              </div>
              <div class="settings-card-foot">
                <button type="button" class="btn btn-primary" id="today-deals-save-btn"><i class="ti ti-device-floppy"></i> Save Today Deals</button>
              </div>
            </div>
          </div>

          <!-- Promo cards -->
          <div class="settings-panel" id="marketing-panel-promo" role="tabpanel">
            <div class="settings-card" style="margin-bottom:16px;">
              <div class="settings-card-head">
                <div class="settings-card-icon settings-card-icon--pink"><i class="ti ti-layout-cards"></i></div>
                <div>
                  <h3 class="settings-card-title">Homepage promo cards</h3>
                  <p class="settings-card-desc">Two cards below Best Selling — left promo + right phone subscribe.</p>
                </div>
              </div>
              <div class="settings-card-body">
                <div class="settings-row" style="margin-bottom:18px;">
                  <div><div>Show marketing section</div><div class="settings-row-info">Appears on homepage below product rows</div></div>
                  <label class="toggle"><input type="checkbox" id="mkt-enabled" checked><span class="toggle-slider"></span></label>
                </div>
                <div class="marketing-promo-grid">
                  <div class="settings-card marketing-promo-card">
                    <div class="settings-card-head" style="padding-top:16px;">
                      <div class="settings-card-icon settings-card-icon--pink" style="width:38px;height:38px;font-size:18px;"><i class="ti ti-layout-sidebar"></i></div>
                      <div><h4 class="settings-card-title" style="font-size:14px;">Left card</h4></div>
                    </div>
                    <div class="settings-card-body" style="padding-top:8px;">
                      <form id="marketing-card1-form">
                        <div class="form-group"><label class="form-label">Heading</label><input class="form-input" id="mkt1-title"></div>
                        <div class="form-group"><label class="form-label">Description</label><textarea class="form-input form-textarea" id="mkt1-desc" rows="3"></textarea></div>
                        <div class="form-2col">
                          <div class="form-group"><label class="form-label">Button text</label><input class="form-input" id="mkt1-btn"></div>
                          <div class="form-group"><label class="form-label">Button link</label><input class="form-input" id="mkt1-link" placeholder="#products"></div>
                        </div>
                        <div class="form-group">
                          <label class="form-label">Image</label>
                          <input class="form-input" id="mkt1-image" placeholder="/uploads/...">
                          <input class="form-input" type="file" id="mkt1-file" accept="image/jpeg,image/png,image/webp,image/gif" style="margin-top:8px;">
                          <div id="mkt1-preview-wrap" hidden style="margin-top:8px;"><img id="mkt1-preview" alt="Preview" class="marketing-img-preview"></div>
                        </div>
                        <div class="form-group"><label class="form-label">Background color</label><input class="form-input" id="mkt1-bg" placeholder="#FDE8EF"></div>
                      </form>
                    </div>
                  </div>
                  <div class="settings-card marketing-promo-card">
                    <div class="settings-card-head" style="padding-top:16px;">
                      <div class="settings-card-icon settings-card-icon--purple" style="width:38px;height:38px;font-size:18px;"><i class="ti ti-phone"></i></div>
                      <div><h4 class="settings-card-title" style="font-size:14px;">Right card (subscribe)</h4></div>
                    </div>
                    <div class="settings-card-body" style="padding-top:8px;">
                      <form id="marketing-card2-form">
                        <div class="form-group"><label class="form-label">Heading</label><input class="form-input" id="mkt2-title"></div>
                        <div class="form-group"><label class="form-label">Description</label><textarea class="form-input form-textarea" id="mkt2-desc" rows="3"></textarea></div>
                        <div class="form-group"><label class="form-label">Submit button</label><input class="form-input" id="mkt2-btn" placeholder="Submit"></div>
                        <div class="form-group">
                          <label class="form-label">Image</label>
                          <input class="form-input" id="mkt2-image" placeholder="/uploads/...">
                          <input class="form-input" type="file" id="mkt2-file" accept="image/jpeg,image/png,image/webp,image/gif" style="margin-top:8px;">
                          <div id="mkt2-preview-wrap" hidden style="margin-top:8px;"><img id="mkt2-preview" alt="Preview" class="marketing-img-preview"></div>
                        </div>
                        <div class="form-group"><label class="form-label">Background color</label><input class="form-input" id="mkt2-bg" placeholder="#E8F3EA"></div>
                      </form>
                    </div>
                  </div>
                </div>
              </div>
              <div class="settings-card-foot">
                <button type="button" class="btn btn-primary" id="marketing-save-btn"><i class="ti ti-device-floppy"></i> Save Promo Cards</button>
              </div>
            </div>
          </div>

          <!-- Popups -->
          <div class="settings-panel" id="marketing-panel-popups" role="tabpanel">
            <div class="settings-card">
              <div class="settings-card-head">
                <div class="settings-card-icon settings-card-icon--purple"><i class="ti ti-layout"></i></div>
                <div>
                  <h3 class="settings-card-title">Popup templates</h3>
                  <p class="settings-card-desc">5 ready-made popup templates — edit text and images, no code required.</p>
                </div>
              </div>
              <div class="settings-card-body">
                <div class="settings-row" style="margin-bottom:16px;">
                  <div><div>Enable popups</div><div class="settings-row-info">Popups appear on homepage only</div></div>
                  <label class="toggle"><input type="checkbox" id="popup-enabled" checked><span class="toggle-slider"></span></label>
                </div>
                <div class="form-group">
                  <label class="form-label">Show popup every (hours)</label>
                  <input class="form-input" id="popup-interval-hours" type="number" min="1" max="168" value="24" style="max-width:180px;">
                  <small class="form-hint">Example: 24 = once per day. This applies per browser/device.</small>
                </div>

                <div class="popup-live-preview-section">
                  <div class="popup-live-preview-head">
                    <div>
                      <h4 class="popup-live-preview-title"><i class="ti ti-eye"></i> Live preview</h4>
                      <p class="form-hint" style="margin:0;">Changes update instantly as you edit the active template.</p>
                    </div>
                    <div class="popup-live-preview-actions">
                      <button type="button" class="btn btn-outline btn-sm" id="popup-fullscreen-preview-btn"><i class="ti ti-arrows-maximize"></i> Full screen</button>
                      <button type="button" class="btn btn-primary btn-sm" id="popup-site-preview-btn"><i class="ti ti-external-link"></i> Preview on homepage</button>
                    </div>
                  </div>
                  <div class="popup-live-preview-stage" id="popup-live-preview-stage" aria-label="Popup preview">
                    <article class="popup-prev-card" id="popup-prev-card" data-popup-theme="gift">
                      <button type="button" class="popup-prev-close" tabindex="-1" aria-hidden="true"><i class="ti ti-x"></i></button>
                      <div class="popup-prev-grid">
                        <div class="popup-prev-visual">
                          <div class="popup-prev-img" id="popup-prev-img"><i class="ti ti-photo"></i></div>
                          <div class="popup-prev-badge"><i class="ti ti-gift" id="popup-prev-badge-icon"></i> <span id="popup-prev-badge">Surprise gift</span></div>
                        </div>
                        <div class="popup-prev-content">
                          <div class="popup-prev-theme-icon" id="popup-prev-theme-icon" hidden aria-hidden="true"></div>
                          <span class="popup-prev-kicker" id="popup-prev-kicker">Exclusive offer</span>
                          <h3 class="popup-prev-title" id="popup-prev-title">Get Surprise gift</h3>
                          <p class="popup-prev-desc" id="popup-prev-desc">Subscribe with your phone number…</p>
                          <div class="popup-prev-form" id="popup-prev-form">
                            <div class="popup-prev-field"><i class="ti ti-phone"></i><span>01XXXXXXXXX</span></div>
                            <button type="button" class="popup-prev-submit" tabindex="-1"><span id="popup-prev-button">Submit</span><i class="ti ti-arrow-right"></i></button>
                          </div>
                          <p class="popup-prev-note" id="popup-prev-note"><i class="ti ti-shield-check"></i> Your number is safe — no spam, ever.</p>
                        </div>
                      </div>
                    </article>
                  </div>
                </div>

                <div class="popup-preview-modal" id="popup-preview-modal" hidden aria-hidden="true">
                  <div class="popup-preview-modal-backdrop" data-close-popup-preview></div>
                  <div class="popup-preview-modal-dialog" role="dialog" aria-modal="true" aria-label="Popup full preview">
                    <button type="button" class="popup-preview-modal-close" data-close-popup-preview aria-label="Close preview"><i class="ti ti-x"></i></button>
                    <div class="popup-live-preview-stage popup-live-preview-stage--modal" id="popup-preview-modal-stage"></div>
                  </div>
                </div>

                <div class="form-group">
                  <label class="form-label">Edit templates</label>
                  <p class="form-hint" style="margin-bottom:12px;">Pick a tab, edit fields, then click <strong>Save Popups</strong>. The open tab becomes the live homepage popup (marked <span class="popup-tab-live-badge popup-tab-live-badge--inline">Live</span>).</p>
                  <div class="popup-template-tabs" id="popup-template-tabs" role="tablist">
                    <% const popupTabLabels = [
                      { id: 'gift', label: 'Gift', icon: 'ti-gift' },
                      { id: 'points', label: 'Points', icon: 'ti-award' },
                      { id: 'delivery', label: 'Delivery', icon: 'ti-truck-delivery' },
                      { id: 'new', label: 'New', icon: 'ti-sparkles' },
                      { id: 'support', label: 'Support', icon: 'ti-message-circle-2' },
                    ]; %>
                    <% popupTabLabels.forEach((tab, i) => { %>
                    <button type="button" class="popup-template-tab<%= i === 0 ? ' active' : '' %>" data-popup-tab="<%= i %>" role="tab" aria-selected="<%= i === 0 ? 'true' : 'false' %>">
                      <i class="ti <%= tab.icon %>"></i> <%= tab.label %>
                    </button>
                    <% }); %>
                  </div>
                  <div id="popup-templates-editor">
                    <% popupTabLabels.forEach((tab, i) => { %>
                    <div class="popup-template-panel<%= i === 0 ? ' active' : '' %>" id="popup-tpl-panel-<%= i %>" data-popup-panel="<%= i %>" role="tabpanel">
                      <div class="popup-template-panel-head">
                        <div>
                          <strong><%= tab.label %> popup</strong>
                          <small>ID: <code><%= tab.id %></code></small>
                        </div>
                        <label class="toggle popup-tpl-enabled-wrap" title="Turn off to hide this template from the site">
                          <span class="popup-tpl-enabled-label">Enabled</span>
                          <input type="checkbox" id="popup-tpl-<%= i %>-enabled" checked>
                          <span class="toggle-slider"></span>
                        </label>
                      </div>
                      <input type="hidden" id="popup-tpl-<%= i %>-id" value="<%= tab.id %>">
                      <div class="form-2col">
                        <div class="form-group"><label class="form-label">Kicker (small label)</label><input class="form-input" id="popup-tpl-<%= i %>-kicker" placeholder="Exclusive offer"></div>
                        <div class="form-group"><label class="form-label">Badge</label><input class="form-input" id="popup-tpl-<%= i %>-badge" placeholder="Surprise gift"></div>
                      </div>
                      <div class="form-2col">
                        <div class="form-group"><label class="form-label">Title</label><input class="form-input" id="popup-tpl-<%= i %>-title" placeholder="Popup headline"></div>
                        <div class="form-group"><label class="form-label">Button text</label><input class="form-input" id="popup-tpl-<%= i %>-button" placeholder="Submit"></div>
                      </div>
                      <div class="form-group"><label class="form-label">Description</label><textarea class="form-input form-textarea" id="popup-tpl-<%= i %>-desc" rows="3" placeholder="Short message for visitors"></textarea></div>
                      <div class="form-2col">
                        <div class="form-group">
                          <label class="form-label">Action</label>
                          <select class="form-input form-select" id="popup-tpl-<%= i %>-mode"<%= tab.id === 'points' ? ' disabled title="Reward points popup always uses a signup button"' : '' %>>
                            <option value="subscribe">Phone subscribe form</option>
                            <option value="link">Go to link (button)</option>
                          </select>
                          <% if (tab.id === 'points') { %><small class="form-hint">Signup button only — no phone field on this popup.</small><% } %>
                        </div>
                        <div class="form-group popup-tpl-link-wrap" id="popup-tpl-<%= i %>-link-wrap">
                          <label class="form-label">Link URL</label>
                          <input class="form-input" id="popup-tpl-<%= i %>-link" placeholder="/account or /track">
                        </div>
                      </div>
                      <div class="form-2col">
                        <div class="form-group"><label class="form-label">Badge icon</label>
                          <select class="form-input form-select" id="popup-tpl-<%= i %>-icon">
                            <option value="ti-gift">Gift</option>
                            <option value="ti-award">Award</option>
                            <option value="ti-truck-delivery">Delivery</option>
                            <option value="ti-sparkles">Sparkles</option>
                            <option value="ti-message-circle-2">Message</option>
                            <option value="ti-discount-2">Discount</option>
                            <option value="ti-shopping-bag">Shopping</option>
                          </select>
                        </div>
                        <div class="form-group"><label class="form-label">Image URL</label><input class="form-input popup-tpl-image" id="popup-tpl-<%= i %>-image" data-popup-idx="<%= i %>" placeholder="/uploads/... (optional)"></div>
                      </div>
                      <div class="form-group"><label class="form-label">Upload image</label><input class="form-input" type="file" id="popup-tpl-<%= i %>-file" accept="image/jpeg,image/png,image/webp,image/gif"></div>
                      <div class="popup-tpl-preview-wrap" id="popup-tpl-<%= i %>-preview-wrap" hidden>
                        <img id="popup-tpl-<%= i %>-preview" alt="" class="popup-tpl-preview">
                      </div>
                    </div>
                    <% }); %>
                  </div>
                </div>

                <div class="form-group" style="margin-top:8px;">
                  <button type="button" class="btn btn-outline" id="popup-reset-btn"><i class="ti ti-refresh"></i> Reset all to defaults</button>
                </div>
              </div>
              <div class="settings-card-foot">
                <button type="button" class="btn btn-primary" id="popup-save-btn"><i class="ti ti-device-floppy"></i> Save Popups</button>
              </div>
            </div>
          </div>

          <!-- Subscribers -->
          <div class="settings-panel" id="marketing-panel-subscribers" role="tabpanel">
            <div class="settings-card">
              <div class="settings-card-head">
                <div class="settings-card-icon settings-card-icon--blue"><i class="ti ti-phone"></i></div>
                <div>
                  <h3 class="settings-card-title">Phone subscribers</h3>
                  <p class="settings-card-desc">Numbers collected from the homepage subscribe card.</p>
                </div>
              </div>
              <div class="settings-card-body" style="padding-bottom:0;">
                <div class="table-wrap" style="margin:0;border:none;box-shadow:none;">
                  <div class="table-header">
                    <h3 style="font-size:15px;margin:0;">All subscribers</h3>
                    <div class="table-actions">
                      <input class="tbl-search" id="subscribers-search" type="text" placeholder="Search phone...">
                      <select class="tbl-select" id="subscribers-status-filter">
                        <option value="all">All status</option>
                        <option value="new">New</option>
                        <option value="read">Read</option>
                        <option value="archived">Archived</option>
                      </select>
                    </div>
                  </div>
                  <table class="tbl"><thead><tr><th>Phone</th><th>Source</th><th>Date</th><th>Status</th><th>Action</th></tr></thead>
                  <tbody id="subscribers-tbody"></tbody></table>
                  <div class="pagination-bar" id="subscribers-pagination"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
