<% if (typeof heroLcp !== 'undefined' && heroLcp && heroLcp.src) { %>
<div class="hero-main hero-main--slider hero-main--has-bg-photo" id="hero-main" role="region" aria-label="Home banner" data-hero-ssr="1">
  <div class="hero-banner-slider">
    <div class="hero-banner-slider-track" id="hero-banner-slider-track">
      <% if (heroLcp.link) { %>
      <a href="<%= heroLcp.link %>" class="hero-banner-slide" data-slide-index="0">
        <img class="hero-banner-slide-photo" src="<%= heroLcp.src %>" alt="<%= heroLcp.alt %>" width="1200" height="400" fetchpriority="high" loading="eager" decoding="async" onerror="this.remove();">
      </a>
      <% } else { %>
      <div class="hero-banner-slide" data-slide-index="0">
        <img class="hero-banner-slide-photo" src="<%= heroLcp.src %>" alt="<%= heroLcp.alt %>" width="1200" height="400" fetchpriority="high" loading="eager" decoding="async" onerror="this.remove();">
      </div>
      <% } %>
    </div>
    <button type="button" class="hero-banner-slider-nav hero-banner-slider-nav--prev" aria-label="Previous slide" hidden><i class="ti ti-chevron-left"></i></button>
    <button type="button" class="hero-banner-slider-nav hero-banner-slider-nav--next" aria-label="Next slide" hidden><i class="ti ti-chevron-right"></i></button>
    <div class="hero-banner-slider-dots" id="hero-banner-slider-dots" role="tablist" aria-label="Banner slides"></div>
  </div>
</div>
<% } else { %>
<div class="hero-main" id="hero-main" role="region" aria-label="Home banner"></div>
<% } %>
