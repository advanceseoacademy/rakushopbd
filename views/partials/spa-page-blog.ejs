<div class="page-wrap blog-page-wrap">
  <div class="page-hero" id="blog-hero">
    <h1 class="page-title"><i class="ti ti-file-text"></i> <span id="blog-hero-title">Blog</span></h1>
    <p class="page-sub" id="blog-hero-sub">Tips, guides and updates from RakuShopBD.</p>
  </div>

  <div id="blog-list-view">
    <div class="blog-grid" id="blog-grid">
      <p class="blog-loading" id="blog-loading">Loading articles…</p>
    </div>
    <div class="blog-pagination" id="blog-pagination" hidden></div>
  </div>

  <div id="blog-single-view" hidden>
    <div class="blog-read-progress" id="blog-read-progress" aria-hidden="true"><span id="blog-read-progress-bar"></span></div>
    <article class="blog-article">
      <nav class="blog-article-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="blog-article-breadcrumb-sep" aria-hidden="true">/</span>
        <a href="/blog" id="blog-breadcrumb-list">Blog</a>
        <span class="blog-article-breadcrumb-sep" aria-hidden="true">/</span>
        <span class="blog-article-breadcrumb-current" id="blog-breadcrumb-current">Article</span>
      </nav>

      <header class="blog-article-header">
        <div class="blog-article-header-inner">
          <p class="blog-article-kicker"><i class="ti ti-sparkles" aria-hidden="true"></i> RakuShopBD Blog</p>
          <h1 class="blog-article-title" id="blog-single-title"></h1>
          <p class="blog-article-lead" id="blog-single-excerpt" hidden></p>
          <div class="blog-article-meta">
            <time class="blog-article-date" id="blog-single-meta" datetime=""></time>
            <span class="blog-article-meta-dot" aria-hidden="true">·</span>
            <span class="blog-article-read-time" id="blog-single-read-time"></span>
          </div>
        </div>
      </header>

      <figure class="blog-article-hero" id="blog-single-hero" hidden>
        <img class="blog-article-hero-img" id="blog-single-image" alt="" loading="eager" decoding="async">
      </figure>

      <div class="blog-article-body">
        <div class="blog-article-content entry-content" id="blog-single-content"></div>
      </div>

      <footer class="blog-article-footer">
        <div class="blog-article-footer-actions">
          <a href="/blog" class="blog-back-link" id="blog-back-link"><i class="ti ti-arrow-left" aria-hidden="true"></i> Back to all articles</a>
          <a href="/" class="blog-shop-cta"><i class="ti ti-shopping-bag" aria-hidden="true"></i> Shop at RakuShopBD</a>
        </div>
        <p class="blog-article-footer-note">Original Japanese skincare &amp; beauty — delivered across Bangladesh.</p>
      </footer>
    </article>
  </div>
</div>
