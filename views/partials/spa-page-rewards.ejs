<div class="page-wrap rewards-page">
  <div class="rewards-hero">
    <p class="rewards-eyebrow" id="rewards-eyebrow"></p>
    <h1 class="page-title" id="rewards-hero-title"><i class="ti ti-award"></i> <span id="rewards-title-text"></span></h1>
    <p class="page-sub" id="rewards-hero-intro"></p>
  </div>

  <div class="rewards-tiers" id="rewards-tiers"></div>

  <section class="rewards-section page-card">
    <div class="page-card-body">
      <h2 class="rewards-section-title" id="rewards-extra-title"><i class="ti ti-sparkles"></i> <span></span></h2>
      <p class="rewards-section-sub" id="rewards-extra-sub"></p>
      <ul class="rewards-bullet-list" id="rewards-extra-list"></ul>
    </div>
  </section>

  <section class="rewards-section page-card">
    <div class="page-card-body">
      <h2 class="rewards-section-title" id="rewards-redeem-title"><i class="ti ti-gift"></i> <span></span></h2>
      <ul class="rewards-bullet-list rewards-bullet-list--plain" id="rewards-redeem-list"></ul>
    </div>
  </section>

  <div class="rewards-cta">
    <h2 id="rewards-cta-title"></h2>
    <p id="rewards-cta-text"></p>
    <div class="rewards-cta-actions">
      <a href="/" class="rewards-btn rewards-btn--primary" id="rewards-cta-shop" data-rewards-shop><i class="ti ti-shopping-bag"></i> <span></span></a>
      <a href="/account" class="rewards-btn rewards-btn--outline" id="rewards-cta-account" data-rewards-account><i class="ti ti-user"></i> <span></span></a>
    </div>
  </div>
</div>
