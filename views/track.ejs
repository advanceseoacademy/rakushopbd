<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Track Order • RakuShopBD</title>
<link rel="icon" href="/images/rakushopbd-logo.png" type="image/png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">
<link rel="stylesheet" href="/css/main.css?v=4">
<link rel="stylesheet" href="/css/responsive.css?v=1">
<style>
  .track-wrap { max-width: 1100px; margin: 0 auto; padding: 24px 20px 48px; }
  .track-grid { display:grid; grid-template-columns:1.1fr .9fr; gap:16px; }
  @media(max-width:900px){ .track-grid { grid-template-columns:1fr; } }
  .trk-card {
    background: var(--surface); border:1px solid var(--border); border-radius:var(--radius-lg);
    box-shadow: 0 18px 50px rgba(15,23,42,.08); overflow:hidden;
  }
  .trk-head {
    padding:18px 18px 14px; border-bottom:1px solid var(--border);
    background: linear-gradient(135deg, var(--primary-pale), rgba(59,130,246,.08));
  }
  .trk-title { margin:0; font-size:18px; font-weight:800; display:flex; align-items:center; gap:8px; }
  .trk-title i { color: var(--primary); font-size:20px; }
  .trk-sub { margin:6px 0 0; color:var(--text-muted); font-size:13px; line-height:1.6; }
  .trk-body { padding:16px 18px 18px; }
  .trk-form { display:flex; gap:10px; align-items:center; flex-wrap:wrap; }
  .trk-input-wrap {
    flex:1; min-width:220px; display:flex; align-items:center; gap:10px; padding:10px 12px;
    border-radius:14px; background:var(--surface2); border:1.5px solid var(--border);
  }
  .trk-input-wrap i { color:var(--primary); font-size:18px; }
  .trk-input {
    flex:1; border:none; outline:none; background:transparent; font-family:inherit;
    font-size:14px; font-weight:800; color:var(--text);
  }
  .trk-btn {
    border:none; cursor:pointer; border-radius:14px; padding:11px 16px; font-weight:800;
    font-family:inherit; color:#fff; background:linear-gradient(135deg,var(--primary),var(--primary-dark));
    display:inline-flex; align-items:center; gap:8px; box-shadow:0 10px 24px rgba(32,96,32,.22);
  }
  .trk-btn:disabled { opacity:.7; cursor:not-allowed; }
  .trk-hint { margin-top:10px; font-size:12px; color:#94a3b8; }
  .trk-result { margin-top:14px; }
  .trk-box { border:1px solid var(--border); border-radius:16px; overflow:hidden; background:#fff; }
  .trk-r-head { padding:12px 14px; display:flex; align-items:center; justify-content:space-between; gap:10px; border-bottom:1px solid var(--border); }
  .trk-r-head b { font-weight:1000; }
  .trk-status {
    font-size:11px; font-weight:1000; padding:6px 10px; border-radius:999px; border:1px solid var(--border);
    background:var(--surface2); text-transform:uppercase; letter-spacing:.4px;
  }
  .trk-status.pending { background:#fef3c7; border-color:rgba(245,158,11,.25); color:#92400e; }
  .trk-status.confirmed,.trk-status.shipped { background:#dbeafe; border-color:rgba(59,130,246,.25); color:#1e40af; }
  .trk-status.delivered { background:#dcfce7; border-color:rgba(34,197,94,.25); color:#166534; }
  .trk-status.cancelled { background:#fee2e2; border-color:rgba(239,68,68,.25); color:#991b1b; }
  .trk-r-body { padding:12px 14px; }
  .trk-meta { display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-bottom:10px; }
  @media(max-width:520px){ .trk-meta { grid-template-columns:1fr; } }
  .trk-m { font-size:12px; color:var(--text-muted); }
  .trk-m b { color:var(--text); }
  .trk-items { border-top:1px dashed var(--border); padding-top:10px; }
  .trk-item { display:flex; justify-content:space-between; gap:10px; font-size:12px; color:var(--text-muted); padding:6px 0; }
  .trk-item b { color:var(--text); font-weight:900; }
  .trk-total { display:flex; justify-content:space-between; margin-top:8px; padding-top:10px; border-top:1px solid var(--border); font-weight:1000; }
  .trk-err {
    padding:12px 14px; color:#991b1b; font-weight:900; background:#fff1f2;
    border:1px solid rgba(239,68,68,.25); border-radius:14px;
  }
  .trk-step { display:flex; gap:12px; align-items:flex-start; padding:12px; border-radius:16px; border:1px solid var(--border); background:rgba(255,255,255,.75); margin-bottom:10px; }
  .trk-step i { color:var(--primary); font-size:20px; margin-top:2px; }
  .trk-step b { display:block; font-size:13px; }
  .trk-step span { display:block; font-size:12px; color:var(--text-muted); line-height:1.6; margin-top:2px; }
</style>
</head>
<body>
<div class="announcement">
 <i class="ti ti-bolt"></i>
 <span>Track your order in seconds with Order ID</span>
 <i class="ti ti-bolt"></i>
</div>

<nav class="navbar">
 <div class="navbar-inner">
 <a href="/" class="logo site-logo-link" aria-label="RakuShopBD — Home">
  <img src="/images/rakushopbd-logo.png" alt="RakuShopBD — Comfort Your Life" class="site-logo-img site-logo-img--header" width="280" height="68">
 </a>
 <div class="search-wrap" id="header-search-wrap">
 <div class="search-bar">
 <select class="search-select" id="search-category" aria-label="Category">
 <option value="all">All Products</option>
 </select>
 <div class="search-field">
 <input class="search-input" id="search-input" type="text" autocomplete="off" placeholder="Search products..." aria-autocomplete="list" aria-controls="search-suggest" aria-expanded="false">
 <button type="button" class="search-clear" id="search-clear" aria-label="Clear search" hidden><i class="ti ti-x"></i></button>
 </div>
 <button type="button" class="search-btn" id="search-btn" aria-label="Search"><i class="ti ti-search"></i></button>
 </div>
 <div class="search-suggest" id="search-suggest" role="listbox" hidden></div>
 </div>
